generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────


enum ComplexityEnum {
  Introductory
  Foundational
  Challenging
}

enum SessionTypeEnum {
  Individual
  Group
}

enum SessionStatusEnum {
  Pending
  Accepted
  Rejected
  Completed
  Canceled
}

enum LocationTypeEnum {
  Virtual
  Custom
}

enum TutorApplicationStatusEnum {
  Pending
  Approved
  Rejected
}

enum PaymentStatusEnum {
  pending
  paid
  failed
}

enum TutorPayoutStatusEnum {
  pending
  paid
}

// ─── CUPONES ──────────────────────────────────────────────────────────
// Tipo de descuento: porcentaje sobre el precio de lista o monto fijo en COP.
enum CouponDiscountTypeEnum {
  PERCENT
  FIXED
}

// Quién asume el descuento:
//   CALICO → el tutor recibe su 85 % del precio de lista; el descuento sale
//            de la comisión de Calico.
//   SHARED → el tutor acordó participar: recibe su 85 % del monto cobrado.
enum CouponAbsorberEnum {
  CALICO
  SHARED
}

// Ciclo de vida de una redención: se RESERVA al crear el intento de pago,
// pasa a APPROVED cuando Wompi aprueba y se RELEASED si el pago falla.
// Una reserva sin pago deja de contar sola pasados 30 minutos.
enum CouponRedemptionStatusEnum {
  RESERVED
  APPROVED
  RELEASED
}

enum ReviewStatusEnum {
  pending
  done
}

enum TutorCourseStatusEnum {
  Pending
  Approved
  Rejected
}

enum CourseSuggestionStatusEnum {
  Pending
  Approved
  Rejected
}

// ─── CAREERS ──────────────────────────────────────────────────────────

model Career {
  id      String   @id @default(uuid())
  code    String   @unique
  name    String
  users   User[]
  courses Course[]

  @@map("careers")
}

// ─── AUTH PROVIDER ENUM ───────────────────────────────────────────────

enum AuthProviderEnum {
  Local
  Google
}

enum UserKind {
  Registered
  ExternalTemporary
}

enum SessionSourceEnum {
  Platform
  ManualAdmin
}

// ─── USER ROLE ────────────────────────────────────────────────────────
// Base role of the user. Orthogonal to `isTutorApproved` — an admin can
// also be an approved tutor if needed. New roles (MODERATOR, SUPPORT…)
// can be added without schema changes elsewhere.
enum Role {
  STUDENT
  ADMIN
}

// ─── USERS ────────────────────────────────────────────────────────────

// ─── EVENTOS (repasos grupales) ───────────────────────────────────────
enum EventStatusEnum {
  Draft
  Published
  Canceled
}

enum EventModalityEnum {
  Virtual
  InPerson
}

enum EventRegistrationStatusEnum {
  PendingPayment
  Confirmed
  Canceled
}

enum EventPaymentFlagEnum {
  DUPLICATE
  EVENT_CANCELED
  REGISTRATION_CANCELED
  EARLY_BIRD_OVERRUN
}

enum EventRefundStatusEnum {
  None
  Pending
  Refunded
}

enum PaymentIntentKindEnum {
  session
  event
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  name             String
  phoneNumber      String?  @map("phone_number")
  phoneNumberNormalized String? @unique @map("phone_number_normalized")
  profilePictureUrl String? @map("profile_picture_url")
  careerId         String?  @map("career_id")

  // OAuth fields
  authProvider     AuthProviderEnum @default(Local) @map("auth_provider")
  googleId         String?          @unique @map("google_id")

  // Roles y estado
  role             Role    @default(STUDENT)
  kind             UserKind @default(Registered)
  isTutorRequested Boolean @default(false) @map("is_tutor_requested")
  isTutorApproved  Boolean @default(false) @map("is_tutor_approved")
  isActive         Boolean @default(true)  @map("is_active")
  isEmailVerified  Boolean @default(false) @map("is_email_verified")

  // Incremented on password change/reset to invalidate previously-issued JWTs.
  // Column already exists in the DB (migration 20260613000000) but was never
  // declared here, so Prisma silently dropped every read/write of it.
  tokenVersion     Int     @default(0)     @map("token_version")

  // Moderación (suspensión por mala conducta o ratings bajos)
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  suspendedById   String?   @map("suspended_by_id")

  // Terms and conditions
  terms            Boolean @default(false)
  marketingOptInAt DateTime? @map("marketing_opt_in_at")

  // Tokens de verificación y reset
  verificationToken       String?   @map("verification_token")
  verificationTokenExpiry DateTime? @map("verification_token_expiry")
  resetToken              String?   @map("reset_token")
  resetTokenExpiry        DateTime? @map("reset_token_expiry")
  otpCode           String?   @map("otp_code")
  otpCodeExpiry     DateTime? @map("otp_code_expiry")
  // Failed OTP verification attempts for the current code. Reset to 0 when a
  // fresh OTP is issued; once it hits the cap the code is invalidated to stop
  // brute-forcing the 6-digit OTP (server-side, survives across instances).
  otpAttempts       Int       @default(0) @map("otp_attempts")

  // Última vez que el usuario estuvo en la app ("last seen"). Se usa para
  // métricas de engagement (usuarios activos en la última semana). Como la
  // sesión JWT persiste, NO basta con el login: se refresca también en el
  // heartbeat /api/auth/me (con throttle). Best-effort / fire-and-forget.
  lastSeenAt DateTime? @map("last_seen_at")

  // Calificación como ESTUDIANTE (tutores → estudiante, estilo Uber).
  // Agregado denormalizado de student_reviews con status 'done' — mismo
  // patrón que TutorProfile.review/numReview. PRIVADA: visible solo para
  // tutores con una sesión vinculada a este estudiante, para admins y para
  // el propio estudiante (solo el número, nunca los comentarios).
  studentRating      Decimal @default(0) @db.Decimal(3, 2) @map("student_rating")
  studentRatingCount Int     @default(0) @map("student_rating_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Relaciones
  career         Career?        @relation(fields: [careerId], references: [id])
  tutorProfile   TutorProfile?
  schedule       Schedule?      @relation("UserSchedule")
  availabilities Availability[]
  tutorSessions  Session[]              @relation("TutorSessions")
  participations SessionParticipant[]
  reviewsWritten Review[]               @relation("ReviewsWritten")
  eventsCreated      Event[]             @relation("EventCreator")
  eventTutoring      EventTutor[]        @relation("EventTutoring")
  eventRegistrations EventRegistration[] @relation("EventRegistrations")
  eventTutorPayouts  EventTutorPayout[]  @relation("EventTutorPayouts")
  reviewsReceived Review[]              @relation("ReviewsReceived")
  studentReviewsWritten  StudentReview[] @relation("StudentReviewsWritten")
  studentReviewsReceived StudentReview[] @relation("StudentReviewsReceived")
  paymentsAsStudent Payment[]           @relation("PaymentsStudent")
  paymentsAsTutor Payment[]             @relation("PaymentsTutor")
  tutorApplications TutorApplication[]
  notifications     Notification[]
  courseNotifySubscriptions CourseNotifySubscription[]

  // Moderación: quién suspendió a este usuario (self-relation)
  suspendedBy   User?  @relation("UserSuspendedBy", fields: [suspendedById], references: [id])
  suspendedUsers User[] @relation("UserSuspendedBy")

  // Aplicaciones de tutor revisadas por este admin
  applicationsReviewed TutorApplication[] @relation("ApplicationReviewedBy")

  // Acciones admin ejecutadas por este usuario
  adminActions  AdminAuditLog[] @relation("AdminActor")
  manualSessionsCreated Session[] @relation("ManualSessionCreator")
  courseSuggestionsRequested CourseSuggestion[] @relation("CourseSuggestionRequester")
  courseSuggestionsReviewed CourseSuggestion[] @relation("CourseSuggestionReviewer")
  newsPosts NewsPost[] @relation("NewsAuthor")
  couponsCreated    Coupon[]           @relation("CouponCreator")
  couponRedemptions CouponRedemption[] @relation("CouponRedemptions")
  marketingPiecesCreated   MarketingPiece[]      @relation("MarketingPieceCreator")
  marketingPiecesUpdated   MarketingPiece[]      @relation("MarketingPieceUpdater")
  marketingPiecesPublished MarketingPiece[]      @relation("MarketingPiecePublisher")
  contentCreatorTokens     ContentCreatorToken[]

  @@map("users")
}

model TutorProfile {
  userId                String        @id @map("user_id")
  schoolEmail           String        @unique @map("school_email")
  experienceYears       Int?          @map("experience_years")
  credits               Int           @default(0)
  experienceDescription String?       @map("experience_description")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  review                Decimal       @default(0) @db.Decimal(3, 2)
  numReview             Int           @default(0) @map("num_review")
  numSessions           Int           @default(0) @map("num_sessions")
  nextPayment           Decimal       @default(0) @map("next_payment") @db.Decimal(12, 2)
  totalEarning          Decimal       @default(0) @map("total_earning") @db.Decimal(12, 2)
  // 2000 = TUTOR_BIO_MAX_LENGTH en src/config/profile.js y el max() de Zod en
  // /api/tutor/profile. Los tres tienen que moverse juntos.
  bio                   String?       @map("bio") @db.VarChar(2000)
  llave                 String?
  tutorCourses          TutorCourse[]
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profiles")
}

model Course {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique
  basePrice    Decimal        @map("base_price") @db.Decimal(10, 2)
  complexity   ComplexityEnum
  aliases      String[]       @default([])
  careerId     String         @map("career_id")
  career       Career             @relation(fields: [careerId], references: [id])
  reviews      Review[]
  events       Event[]
  sessions     Session[]
  tutorCourses TutorCourse[]
  suggestions  CourseSuggestion[]
  notifySubscriptions CourseNotifySubscription[]

  @@index([careerId])
  @@map("courses")
}

model CourseNotifySubscription {
  id                String    @id @default(uuid())
  studentId         String    @map("student_id")
  courseId          String    @map("course_id")
  notificationEmail String    @map("notification_email")
  source            String    @default("unknown")
  notifiedAt        DateTime? @map("notified_at")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, notifiedAt, cancelledAt])
  @@index([studentId, courseId])
  @@map("course_notify_subscriptions")
}

model CourseSuggestion {
  id           String                     @id @default(uuid())
  code         String
  name         String
  notes        String?
  status       CourseSuggestionStatusEnum @default(Pending)
  requesterId  String?                    @map("requester_id")
  reviewedById String?                    @map("reviewed_by_id")
  reviewedAt   DateTime?                  @map("reviewed_at")
  courseId     String?                    @map("course_id")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  requester  User?   @relation("CourseSuggestionRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("CourseSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([code])
  @@map("course_suggestions")
}


model TutorCourse {
  tutorId       String                @map("tutor_id")
  courseId      String                @map("course_id")
  experience    String?               @map("experience")
  workSampleUrl String?               @map("work_sample_url")
  status        TutorCourseStatusEnum @default(Pending)
  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor         TutorProfile          @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  @@id([tutorId, courseId])
  @@map("tutor_courses")
}

model Schedule {
  id                String  @id @default(uuid())
  userId            String  @unique @map("user_id")
  timezone          String  @default("America/Bogota")
  autoAcceptSession Boolean @default(false) @map("auto_accept_session")
  minBookingNotice  Int     @default(24) @map("min_booking_notice")
  maxSessionsPerDay Int     @default(5) @map("max_sessions_per_day")
  bufferTime        Int     @default(15) @map("buffer_time")
  calendarSyncId    String? @map("calendar_sync_id")
  calendarSyncMode  String? @default("available") @map("calendar_sync_mode")

  // Estado de la integración con Google Calendar. Los tokens OAuth viven solo
  // en cookies HttpOnly del navegador del tutor, así que el servidor (y el
  // panel admin) no puede saber si sigue conectado: estas columnas son la
  // única señal persistida. `calendarConnectedAt` se escribe al elegir
  // calendario y se limpia al desconectar; las otras dos, en cada sync.
  calendarConnectedAt  DateTime? @map("calendar_connected_at")
  calendarLastSyncedAt DateTime? @map("calendar_last_synced_at")
  calendarLastSyncOk   Boolean?  @map("calendar_last_sync_ok")

  user              User    @relation("UserSchedule", fields: [userId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Availability {
  id           String    @id @default(uuid())
  dayOfWeek    Int       @map("day_of_week")
  endTime      DateTime  @map("end_time") @db.Time(6)
  startTime    DateTime  @map("start_time") @db.Time(6)
  userId       String    @map("user_id")
  label        String?   @map("label") @db.VarChar(160)
  recurring    Boolean   @default(true) @map("recurring")
  specificDate DateTime? @map("specific_date") @db.Date
  source       String    @default("manual") @map("source")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model Session {
  id             String            @id @default(uuid())
  courseId        String            @map("course_id")
  tutorId         String            @map("tutor_id")
  sessionType    SessionTypeEnum   @map("session_type")
  maxCapacity    Int               @default(1) @map("max_capacity")
  startTimestamp DateTime          @map("start_timestamp")
  endTimestamp   DateTime          @map("end_timestamp")
  status         SessionStatusEnum @default(Pending)
  locationType   LocationTypeEnum  @map("location_type")
  notes          String?
  topicsToReview String?           @map("topics_to_review")
  source         SessionSourceEnum @default(Platform)
  manualCreatedById String?        @map("manual_created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  // Google Calendar integration
  googleCalendarEventId String? @map("google_calendar_event_id")
  googleMeetLink        String? @map("google_meet_link")

  // Cancellation tracking
  cancellationReason String?        @map("cancellation_reason")
  cancelledAt        DateTime?      @map("cancelled_at")
  cancelledBy        String?        @map("cancelled_by")
  refundMethod       String?        @map("refund_method")         // 'bank_transfer', 'nequi', 'use_future_session', etc.
  refundMethodDetails String?       @map("refund_method_details") // Additional info (bank account, etc.)

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  tutor        User                 @relation("TutorSessions", fields: [tutorId], references: [id], onDelete: Restrict)
  manualCreatedBy User?             @relation("ManualSessionCreator", fields: [manualCreatedById], references: [id], onDelete: SetNull)
  participants  SessionParticipant[]
  payments      Payment[]
  reviews       Review[]
  studentReviews StudentReview[]
  notifications Notification[]
  attachments   SessionAttachment[]
  couponRedemptions CouponRedemption[]

  @@map("sessions")
  @@index([tutorId, status, startTimestamp(sort: Desc)])
}

model SessionAttachment {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  s3Key      String   @map("s3_key")
  fileName   String   @map("file_name")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_attachments")
}

model SessionParticipant {
  sessionId        String   @map("session_id")
  studentId        String   @map("student_id")
  joinedAt         DateTime @default(now()) @map("joined_at")
  participantCount Int      @default(1) @map("participant_count")
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([sessionId, studentId])
  @@index([studentId, sessionId])
  @@map("session_participants")
}

model Review {
  id        String           @id @default(uuid())
  rating    Int?
  tutorId   String           @map("tutor_id")
  studentId String           @map("student_id")
  // Arco exclusivo: una reseña es de una sesión O de un evento
  // (CHECK reviews_session_xor_event en prisma/sql/).
  sessionId String?          @map("session_id")
  eventId   String?          @map("event_id")
  comment   String?
  status    ReviewStatusEnum @default(pending)
  courseId  String?          @map("course_id")
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  session   Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student   User             @relation("ReviewsWritten", fields: [studentId], references: [id], onDelete: Cascade)
  tutor     User             @relation("ReviewsReceived", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId, tutorId])
  @@unique([eventId, studentId, tutorId])
  @@index([tutorId, courseId, status])
  @@index([eventId])
  @@map("reviews")
}

// Evento grupal (repaso). Precio fijo en COP (0 = gratis). "Finalizado" se
// deriva de endsAt < now. Ver docs/superpowers/specs/2026-10-03-eventos-design.md
model Event {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  title                 String
  description           String
  coverImageUrl         String?           @map("cover_image_url")
  courseId              String?           @map("course_id")
  startsAt              DateTime          @map("starts_at")
  endsAt                DateTime          @map("ends_at")
  modality              EventModalityEnum
  autoMeet              Boolean           @default(false) @map("auto_meet")
  meetingUrl            String?           @map("meeting_url")
  location              String?
  googleCalendarEventId String?           @map("google_calendar_event_id")
  price                 Decimal           @db.Decimal(10, 2)
  earlyBirdSlots        Int?              @map("early_bird_slots")
  earlyBirdPercent      Int?              @map("early_bird_percent")
  isListed              Boolean           @default(true) @map("is_listed")
  status                EventStatusEnum   @default(Draft)
  publishedAt           DateTime?         @map("published_at")
  canceledAt            DateTime?         @map("canceled_at")
  cancelReason          String?           @map("cancel_reason")
  lastReminderAt        DateTime?         @map("last_reminder_at")
  createdById           String?           @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  course        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tutors        EventTutor[]
  registrations EventRegistration[]
  tutorPayouts  EventTutorPayout[]
  reviews       Review[]

  @@index([status, isListed, startsAt])
  @@map("events")
}

model EventTutor {
  eventId  String @map("event_id")
  tutorId  String @map("tutor_id")
  position Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tutor User  @relation("EventTutoring", fields: [tutorId], references: [id], onDelete: Restrict)

  @@id([eventId, tutorId])
  @@index([tutorId])
  @@map("event_tutors")
}

// Una fila por (evento, usuario). PendingPayment = checkout abierto con una
// reserva de 30 min (reservedAt); Confirmed = inscrito; Canceled = cancelado.
model EventRegistration {
  id                  String                      @id @default(uuid())
  eventId             String                      @map("event_id")
  userId              String                      @map("user_id")
  status              EventRegistrationStatusEnum
  earlyBird           Boolean                     @default(false) @map("early_bird")
  reservedAt          DateTime?                   @map("reserved_at")
  listPrice           Decimal                     @db.Decimal(10, 2) @map("list_price")
  discountAmount      Decimal                     @default(0) @db.Decimal(10, 2) @map("discount_amount")
  finalAmount         Decimal                     @db.Decimal(10, 2) @map("final_amount")
  intentReference     String?                     @unique @map("intent_reference")
  source              String?
  confirmedAt         DateTime?                   @map("confirmed_at")
  canceledAt          DateTime?                   @map("canceled_at")
  canceledBy          String?                     @map("canceled_by")
  refundMethod        String?                     @map("refund_method")
  refundMethodDetails String?                     @map("refund_method_details")
  surveyRemindedAt    DateTime?                   @map("survey_reminded_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  event          Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user           User                 @relation("EventRegistrations", fields: [userId], references: [id], onDelete: Cascade)
  payments       EventPayment[]
  surveyResponse EventSurveyResponse?

  @@unique([eventId, userId])
  @@index([eventId, status, earlyBird])
  @@index([userId, status])
  @@map("event_registrations")
}

// Cada transacción aprobada de Wompi para un evento. wompiId único = barrera
// de idempotencia. flag != null → anomalía visible en admin.
model EventPayment {
  id             String                @id @default(uuid())
  registrationId String                @map("registration_id")
  wompiId        String                @unique @map("wompi_id")
  reference      String
  amount         Decimal               @db.Decimal(10, 2)
  originalAmount Decimal               @db.Decimal(10, 2) @map("original_amount")
  discountAmount Decimal               @db.Decimal(10, 2) @map("discount_amount")
  flag           EventPaymentFlagEnum?
  refundStatus   EventRefundStatusEnum @default(None) @map("refund_status")
  refundedAt     DateTime?             @map("refunded_at")
  refundedById   String?               @map("refunded_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([refundStatus])
  @@map("event_payments")
}

model EventSurveyResponse {
  id             String   @id @default(uuid())
  registrationId String   @unique @map("registration_id")
  attended       Boolean
  eventRating    Int?     @map("event_rating")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("event_survey_responses")
}

// Pago al tutor hecho por fuera de la plataforma; solo trazabilidad.
model EventTutorPayout {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  tutorId     String   @map("tutor_id")
  amount      Decimal  @db.Decimal(10, 2)
  paidAt      DateTime @map("paid_at")
  note        String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tutor User  @relation("EventTutorPayouts", fields: [tutorId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("event_tutor_payouts")
}

model StudentReview {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  tutorId   String           @map("tutor_id")
  studentId String           @map("student_id")
  rating    Int?
  status    ReviewStatusEnum @default(pending)
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User             @relation("StudentReviewsReceived", fields: [studentId], references: [id], onDelete: Cascade)
  tutor     User             @relation("StudentReviewsWritten", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, tutorId, studentId])
  @@index([studentId, status])
  @@map("student_reviews")
}

model Payment {
  createdAt         DateTime              @default(now()) @map("created_at")
  sessionId         String                @map("session_id")
  studentId         String                @map("student_id")
  tutorId           String                @map("tutor_id")
  // Desglose del cobro (single source of truth: src/lib/payments/fees.js):
  //   originalAmount  = precio de lista (precio/hora × horas)
  //   discountAmount  = descuento del cupón (0 sin cupón)
  //   amount          = originalAmount − discountAmount → lo que Wompi cobró
  //   tutorPayoutBase = base del 85 % del tutor: originalAmount cuando Calico
  //                     asume el descuento, amount cuando es compartido
  amount            Decimal               @db.Decimal(10, 2)
  originalAmount    Decimal               @map("original_amount") @db.Decimal(10, 2)
  discountAmount    Decimal               @default(0) @map("discount_amount") @db.Decimal(10, 2)
  tutorPayoutBase   Decimal               @map("tutor_payout_base") @db.Decimal(10, 2)
  couponId          String?               @map("coupon_id")
  // Único: un webhook y un confirm-payment concurrentes no pueden crear dos
  // pagos para la misma transacción (NULL permitido para tutorías manuales).
  wompiId           String?               @unique @map("wompi_id")
  id                String                @id @default(uuid())
  updatedAt         DateTime?             @updatedAt @map("updated_at")
  status            PaymentStatusEnum     @default(pending)
  tutorPayoutStatus TutorPayoutStatusEnum @default(pending) @map("tutor_payout_status")
  tutorPayoutAt     DateTime?             @map("tutor_payout_at")
  tutorPayoutNote   String?               @map("tutor_payout_note")
  tutorPayoutById   String?               @map("tutor_payout_by_id")
  session           Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student           User                  @relation("PaymentsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor             User                  @relation("PaymentsTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  coupon            Coupon?               @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponRedemption  CouponRedemption?

  @@index([tutorPayoutStatus, status])
  @@index([tutorId, tutorPayoutStatus])
  @@index([couponId])
  @@map("payments")
}

model PaymentIntent {
  id         String    @id @default(uuid())
  reference  String    @unique
  metadata   Json
  consumedAt DateTime? @map("consumed_at")
  kind       PaymentIntentKindEnum @default(session)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("payment_intents")
}

// Cupón de descuento que el estudiante escribe antes de pagar. Reglas de
// negocio en src/lib/services/coupon.service.js; matemática pura en
// src/lib/payments/coupon-math.js. Borrado lógico (deletedAt) cuando ya tiene
// redenciones, para no perder trazabilidad.
model Coupon {
  id               String                 @id @default(uuid())
  code             String                 @unique // siempre en mayúsculas
  description      String?
  discountType     CouponDiscountTypeEnum @map("discount_type")
  discountValue    Decimal                @map("discount_value") @db.Decimal(10, 2) // % (1-99) o COP
  absorber         CouponAbsorberEnum     @default(CALICO)
  maxRedemptions   Int?                   @map("max_redemptions") // null = sin límite
  perUserLimit     Int                    @default(1) @map("per_user_limit")
  firstSessionOnly Boolean                @default(false) @map("first_session_only")
  validFrom        DateTime?              @map("valid_from")
  validUntil       DateTime?              @map("valid_until")
  isActive         Boolean                @default(true) @map("is_active")
  createdById      String?                @map("created_by_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")

  createdBy   User?              @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]
  payments    Payment[]

  @@index([isActive, deletedAt])
  @@map("coupons")
}

// Una fila por intento de pago que usó un cupón. Guarda el snapshot del
// desglose para que editar el cupón después no reescriba la historia.
model CouponRedemption {
  id              String                     @id @default(uuid())
  couponId        String                     @map("coupon_id")
  userId          String                     @map("user_id")
  intentReference String                     @unique @map("intent_reference")
  status          CouponRedemptionStatusEnum @default(RESERVED)
  originalAmount  Decimal                    @map("original_amount") @db.Decimal(10, 2)
  discountAmount  Decimal                    @map("discount_amount") @db.Decimal(10, 2)
  finalAmount     Decimal                    @map("final_amount") @db.Decimal(10, 2)
  tutorPayoutBase Decimal                    @map("tutor_payout_base") @db.Decimal(10, 2)
  absorber        CouponAbsorberEnum
  paymentId       String?                    @unique @map("payment_id")
  sessionId       String?                    @map("session_id")
  reservedAt      DateTime                   @default(now()) @map("reserved_at")
  approvedAt      DateTime?                  @map("approved_at")
  releasedAt      DateTime?                  @map("released_at")

  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user    User     @relation("CouponRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([couponId, status, reservedAt])
  @@index([userId, couponId, status])
  @@map("coupon_redemptions")
}

model TutorApplication {
  id              String                     @id @default(uuid())
  userId          String                     @map("user_id")
  reasonsToTeach  String                     @map("reasons_to_teach")
  subjects        String[]
  contactInfo     Json                       @map("contact_info")
  status          TutorApplicationStatusEnum @default(Pending)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  rejectionReason String?                    @map("rejection_reason")
  reviewedAt      DateTime?                  @map("reviewed_at")
  reviewedById    String?                    @map("reviewed_by_id")
  reviewedBy      User?                      @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_applications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  sessionId String?  @map("session_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  session   Session? @relation(fields: [sessionId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Noticias/anuncios publicados por admins y mostrados en la landing y en los
// homes de estudiante y tutor. `content` es Markdown crudo (un solo idioma);
// se renderiza en el cliente sin HTML embebido. `imageUrl` apunta a S3
// (prefijo news-images/), URL pública persistida igual que profilePictureUrl.
model NewsPost {
  id          String    @id @default(uuid())
  title       String
  content     String
  imageUrl    String?   @map("image_url")
  isPublished Boolean   @default(false) @map("is_published")
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime? @map("published_at")
  authorId    String    @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  author      User      @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([isPublished, isPinned, publishedAt(sort: Desc)])
  @@map("news_posts")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])

  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

// Piezas de marketing (posts de Instagram y presentaciones) que se crean con la
// herramienta local content-creator. Aquí vive la fuente compartida de cada
// pieza: brief e historial (`meta`), caption y la lista de archivos fuente
// (`files`: index.html, img/*), que están en S3 bajo marketing-pieces/{slug}/src/.
// Lo publicado (PNG/PDF + manifest.json) sigue en marketing-posts/{slug}/.
// `version` sube en cada guardado: el cliente manda la versión que leyó y si no
// coincide recibe 409 (otra persona guardó antes).
model MarketingPiece {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  type          String
  style         String?
  caption       String    @default("")
  meta          Json      @default("{}")
  files         Json      @default("[]")
  version       Int       @default(1)
  createdById   String    @map("created_by_id")
  updatedById   String    @map("updated_by_id")
  publishedById String?   @map("published_by_id")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     User      @relation("MarketingPieceCreator", fields: [createdById], references: [id])
  updatedBy     User      @relation("MarketingPieceUpdater", fields: [updatedById], references: [id])
  publishedBy   User?     @relation("MarketingPiecePublisher", fields: [publishedById], references: [id])

  @@index([updatedAt(sort: Desc)])
  @@map("marketing_pieces")
}

// Tokens personales para que content-creator use /api/content-creator/*.
// Solo se guarda el SHA-256 del token; el token en claro se muestra una vez al
// crearlo (prisma/create-content-token.mjs). Cada token pertenece a un admin:
// si el usuario deja de ser ADMIN o se desactiva, el token deja de servir.
model ContentCreatorToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  label      String
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("content_creator_tokens")
}

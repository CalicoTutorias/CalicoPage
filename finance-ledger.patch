diff --git a/src/app/home/admin/finanzas/_components/EntriesTab.jsx b/src/app/home/admin/finanzas/_components/EntriesTab.jsx
new file mode 100644
index 0000000..821ae77
--- /dev/null
+++ b/src/app/home/admin/finanzas/_components/EntriesTab.jsx
@@ -0,0 +1,247 @@
+'use client';
+
+import { useCallback, useEffect, useId, useState } from 'react';
+import { ChevronLeft, ChevronRight, Download, FileText, Plus, Undo2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { AdminFinanceService } from '@/app/services/core/AdminFinanceService';
+import { useI18n } from '@/lib/i18n';
+import ConfirmDialog from '../../eventos/_components/ConfirmDialog';
+import {
+  CARD, CHIP, ERROR_BOX, HINT, INK, INPUT, LABEL, MUTED, TABLE_WRAP, TD, TH, TONE, TR,
+} from '../../eventos/_components/ui';
+import EntryFormModal from './EntryFormModal';
+import { dayStartIso, errorText } from './format';
+
+const PAGE_SIZE = 50;
+const TYPES = [
+  'OPENING_BALANCE', 'SESSION_CHARGE', 'EVENT_CHARGE', 'WOMPI_FEE', 'TUTOR_PAYOUT', 'EVENT_TUTOR_PAYOUT',
+  'GMF', 'REFUND', 'TRANSFER', 'EXPENSE', 'OTHER_INCOME', 'ADJUSTMENT', 'REVERSAL',
+];
+
+/** Every movement, newest first, with its proof; manual ones are recorded and reversed here. */
+export default function EntriesTab({ config }) {
+  const { t, formatCurrency, formatDate } = useI18n();
+  const uid = useId();
+  const id = (n) => `${uid}-${n}`;
+  const [filters, setFilters] = useState({ accountId: '', type: '', from: '', to: '' });
+  const [page, setPage] = useState(0);
+  const [reload, setReload] = useState(0);
+  const [list, setList] = useState({ status: 'loading', items: [], total: 0, error: null });
+  const [creating, setCreating] = useState(false);
+  const [reversing, setReversing] = useState(null);
+  const [reason, setReason] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [dialogError, setDialogError] = useState(null);
+  const [actionError, setActionError] = useState(null);
+
+  const query = useCallback(() => ({
+    accountId: filters.accountId || undefined,
+    type: filters.type || undefined,
+    from: filters.from ? dayStartIso(filters.from) : undefined,
+    // `to` is inclusive in the form: up to the start of the next day.
+    to: filters.to ? new Date(new Date(dayStartIso(filters.to)).getTime() + 864e5).toISOString() : undefined,
+  }), [filters]);
+
+  useEffect(() => {
+    let ignore = false;
+    AdminFinanceService.listEntries({ ...query(), limit: PAGE_SIZE, offset: page * PAGE_SIZE }).then((res) => {
+      if (ignore) return;
+      setList(res.success
+        ? { status: 'ready', items: res.items, total: res.total, error: null }
+        : { status: 'error', items: [], total: 0, error: errorText(t, res) });
+    });
+    return () => { ignore = true; };
+  }, [query, page, reload, t]);
+
+  const setFilter = (k, v) => {
+    setFilters((f) => ({ ...f, [k]: v }));
+    setPage(0);
+  };
+
+  const openProof = async (entryId) => {
+    setActionError(null);
+    // Opened synchronously so the popup is not blocked; filled once the URL arrives.
+    const win = window.open('', '_blank');
+    if (win) win.opener = null;
+    const res = await AdminFinanceService.getEntryProofUrl(entryId);
+    if (res.success && win) win.location.href = res.url;
+    else {
+      win?.close();
+      setActionError(errorText(t, res));
+    }
+  };
+
+  const exportCsv = async () => {
+    setActionError(null);
+    const res = await AdminFinanceService.exportEntriesCsv(query());
+    if (!res.success) {
+      setActionError(t('admin.finance.errors.generic'));
+      return;
+    }
+    const url = URL.createObjectURL(res.blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = 'calico-movimientos.csv';
+    a.click();
+    URL.revokeObjectURL(url);
+  };
+
+  const confirmReverse = async () => {
+    setBusy(true);
+    setDialogError(null);
+    const res = await AdminFinanceService.reverseEntry(reversing.id, reason.trim());
+    setBusy(false);
+    if (!res.success) {
+      setDialogError(errorText(t, res));
+      return;
+    }
+    setReversing(null);
+    setReason('');
+    setReload((n) => n + 1);
+  };
+
+  const accountName = (e) => e.account?.name ?? config.accounts.find((a) => a.id === e.account?.id)?.name ?? '—';
+  const totalPages = Math.max(1, Math.ceil(list.total / PAGE_SIZE));
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className={`${CARD} p-4 flex items-end gap-3 flex-wrap`}>
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('account')} className={LABEL}>{t('admin.finance.entries.filters.account')}</label>
+          <select id={id('account')} value={filters.accountId} onChange={(e) => setFilter('accountId', e.target.value)} className={INPUT}>
+            <option value="">{t('admin.finance.entries.filters.all')}</option>
+            {config.accounts.map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}
+          </select>
+        </div>
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('type')} className={LABEL}>{t('admin.finance.entries.filters.type')}</label>
+          <select id={id('type')} value={filters.type} onChange={(e) => setFilter('type', e.target.value)} className={INPUT}>
+            <option value="">{t('admin.finance.entries.filters.all')}</option>
+            {TYPES.map((k) => <option key={k} value={k}>{t(`admin.finance.types.${k}`)}</option>)}
+          </select>
+        </div>
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('from')} className={LABEL}>{t('admin.finance.entries.filters.from')}</label>
+          <input id={id('from')} type="date" value={filters.from} onChange={(e) => setFilter('from', e.target.value)} className={INPUT} />
+        </div>
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('to')} className={LABEL}>{t('admin.finance.entries.filters.to')}</label>
+          <input id={id('to')} type="date" value={filters.to} onChange={(e) => setFilter('to', e.target.value)} className={INPUT} />
+        </div>
+        <div className="flex gap-2 ml-auto">
+          <Button variant="outline" onClick={exportCsv}><Download />{t('admin.finance.entries.export')}</Button>
+          <Button variant="cta" onClick={() => setCreating(true)}><Plus />{t('admin.finance.entries.new')}</Button>
+        </div>
+      </div>
+
+      {actionError && <p role="alert" className={ERROR_BOX}>{actionError}</p>}
+      {list.status === 'loading' && <p className={`text-sm ${MUTED}`}>{t('common.loading')}</p>}
+      {list.status === 'error' && <p className={ERROR_BOX}>{list.error}</p>}
+      {list.status === 'ready' && list.items.length === 0 && (
+        <p className={`${CARD} p-5 text-sm ${MUTED}`}>{t('admin.finance.entries.empty')}</p>
+      )}
+
+      {list.status === 'ready' && list.items.length > 0 && (
+        <div className={TABLE_WRAP}>
+          <table className="w-full text-sm">
+            <thead>
+              <tr>
+                <th className={TH}>{t('admin.finance.entries.columns.date')}</th>
+                <th className={TH}>{t('admin.finance.entries.columns.type')}</th>
+                <th className={TH}>{t('admin.finance.entries.columns.account')}</th>
+                <th className={TH}>{t('admin.finance.entries.columns.detail')}</th>
+                <th className={`${TH} text-right`}>{t('admin.finance.entries.columns.amount')}</th>
+                <th className={TH}>{t('admin.finance.entries.columns.actions')}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {list.items.map((e) => (
+                <tr key={e.id} className={TR}>
+                  <td className={`${TD} whitespace-nowrap ${INK}`}>
+                    {formatDate(e.effectiveAt, { day: 'numeric', month: 'short', year: 'numeric' })}
+                  </td>
+                  <td className={TD}>
+                    <span className={`${CHIP} ${e.direction === 'IN' ? TONE.success : TONE.neutral}`}>
+                      {t(`admin.finance.types.${e.type}`)}
+                    </span>
+                    <div className="flex flex-wrap gap-1 mt-1">
+                      {e.automatic && <span className={`${CHIP} ${TONE.info}`}>{t('admin.finance.entries.automatic')}</span>}
+                      {e.isEstimate && <span className={`${CHIP} ${TONE.warning}`}>{t('admin.finance.entries.estimate')}</span>}
+                      {e.reversed && <span className={`${CHIP} ${TONE.danger}`}>{t('admin.finance.entries.reversed')}</span>}
+                      {e.excludeFromProfit && <span className={`${CHIP} ${TONE.neutral}`}>{t('admin.finance.entries.outOfProfit')}</span>}
+                    </div>
+                  </td>
+                  <td className={`${TD} ${INK}`}>{accountName(e)}</td>
+                  <td className={`${TD} text-xs ${MUTED} max-w-[18rem]`}>
+                    {e.category?.name && <div className={INK}>{e.category.name}</div>}
+                    {e.description && <div className="break-words">{e.description}</div>}
+                    {e.reversesType && <div>{t('admin.finance.entries.reverses', { type: t(`admin.finance.types.${e.reversesType}`) })}</div>}
+                  </td>
+                  <td className={`${TD} text-right whitespace-nowrap font-semibold ${
+                    e.signedAmount < 0 ? 'text-[var(--calico-danger-strong)]' : 'text-[var(--calico-green-success-dark)]'
+                  }`}
+                  >
+                    {formatCurrency(e.signedAmount, 'COP')}
+                  </td>
+                  <td className={TD}>
+                    <div className="flex gap-1">
+                      {e.hasProof && (
+                        <Button size="icon-sm" variant="ghost" aria-label={t('admin.finance.entries.viewProof')} onClick={() => openProof(e.id)}>
+                          <FileText />
+                        </Button>
+                      )}
+                      {!e.reversed && e.type !== 'REVERSAL' && (
+                        <Button size="icon-sm" variant="ghost" aria-label={t('admin.finance.entries.reverse')} onClick={() => setReversing(e)}>
+                          <Undo2 />
+                        </Button>
+                      )}
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+
+      {list.status === 'ready' && list.total > PAGE_SIZE && (
+        <div className="flex items-center justify-between">
+          <span className={`text-xs ${MUTED}`}>{t('admin.payouts.detail.page', { page: page + 1, total: totalPages })}</span>
+          <div className="flex gap-1">
+            <Button size="icon-sm" variant="ghost" disabled={page === 0} onClick={() => setPage((p) => p - 1)} aria-label={t('admin.payouts.detail.previous')}><ChevronLeft /></Button>
+            <Button size="icon-sm" variant="ghost" disabled={page + 1 >= totalPages} onClick={() => setPage((p) => p + 1)} aria-label={t('admin.payouts.detail.next')}><ChevronRight /></Button>
+          </div>
+        </div>
+      )}
+
+      <EntryFormModal
+        key={creating ? 'open' : 'closed'}
+        open={creating}
+        config={config}
+        onClose={() => setCreating(false)}
+        onSaved={() => { setCreating(false); setPage(0); setReload((n) => n + 1); }}
+      />
+
+      <ConfirmDialog
+        open={Boolean(reversing)}
+        title={t('admin.finance.entries.reverseTitle')}
+        message={reversing && t('admin.finance.entries.reverseBody', {
+          type: t(`admin.finance.types.${reversing.type}`),
+          amount: formatCurrency(reversing.amount, 'COP'),
+        })}
+        confirmLabel={t('admin.finance.entries.reverse')}
+        destructive
+        busy={busy}
+        error={dialogError}
+        onConfirm={confirmReverse}
+        onCancel={() => { setReversing(null); setReason(''); setDialogError(null); }}
+      >
+        <div className="flex flex-col gap-1 mt-3">
+          <label htmlFor={id('reason')} className={LABEL}>{t('admin.finance.entryForm.reason')}</label>
+          <input id={id('reason')} type="text" maxLength={500} value={reason} onChange={(e) => setReason(e.target.value)} className={INPUT} />
+          <p className={HINT}>{t('admin.finance.entries.reverseHint')}</p>
+        </div>
+      </ConfirmDialog>
+    </div>
+  );
+}
diff --git a/src/app/home/admin/finanzas/_components/EntryFormModal.jsx b/src/app/home/admin/finanzas/_components/EntryFormModal.jsx
new file mode 100644
index 0000000..f74d2a1
--- /dev/null
+++ b/src/app/home/admin/finanzas/_components/EntryFormModal.jsx
@@ -0,0 +1,211 @@
+'use client';
+
+import { useId, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { AdminFinanceService } from '@/app/services/core/AdminFinanceService';
+import { useI18n } from '@/lib/i18n';
+import { FINANCE_PROOF_ACCEPT } from '@/lib/finance/finance-proof';
+import { PROOF_REQUIRED_KINDS } from '@/lib/finance/ledger-math';
+import { bogotaLocalToUtc } from '@/lib/utils/event-format';
+import { ERROR_BOX, HINT, INK, INPUT, LABEL } from '../../eventos/_components/ui';
+import { errorText, todayInBogota } from './format';
+
+const KINDS = ['EXPENSE', 'OTHER_INCOME', 'TRANSFER', 'ADJUSTMENT', 'OPENING_BALANCE'];
+
+/**
+ * New manual entry: expense, other income, transfer between accounts,
+ * adjustment or opening balance. The proof is uploaded first and its key
+ * sent with the entry (the server checks it).
+ */
+export default function EntryFormModal({ open, config, initialKind = 'EXPENSE', onClose, onSaved }) {
+  const { t } = useI18n();
+  const uid = useId();
+  const id = (n) => `${uid}-${n}`;
+  const accounts = config.accounts.filter((a) => a.isActive);
+  const categories = config.categories.filter((c) => c.isActive);
+  const [form, setForm] = useState(() => ({
+    kind: initialKind,
+    accountId: config.settings.defaultBankAccountId ?? '',
+    toAccountId: '',
+    amount: '',
+    date: todayInBogota(),
+    direction: 'OUT',
+    categoryId: '',
+    description: '',
+    excludeFromProfit: false,
+    file: null,
+  }));
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState(null);
+
+  if (!open) return null;
+  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));
+  const proofRequired = PROOF_REQUIRED_KINDS.includes(form.kind);
+
+  const submit = async (e) => {
+    e.preventDefault();
+    if (busy) return;
+    const amount = Number(form.amount);
+    if (!form.accountId || !Number.isFinite(amount) || amount <= 0) {
+      setError(t('admin.finance.entryForm.required'));
+      return;
+    }
+    if (proofRequired && !form.file) {
+      setError(t('admin.finance.rules.PROOF_REQUIRED'));
+      return;
+    }
+    setBusy(true);
+    setError(null);
+
+    let proofS3Key;
+    if (form.file) {
+      const up = await AdminFinanceService.uploadProof(form.file);
+      if (!up.success) {
+        setBusy(false);
+        setError(errorText(t, up, 'admin.finance.transfer.errors.upload'));
+        return;
+      }
+      proofS3Key = up.s3Key;
+    }
+
+    // A past day is stored at noon in Colombia; today is "now" (server clamps).
+    const effectiveAt = form.kind === 'OPENING_BALANCE' ? undefined : bogotaLocalToUtc(`${form.date}T12:00`).toISOString();
+    const res = await AdminFinanceService.createEntry({
+      kind: form.kind,
+      accountId: form.accountId,
+      amount,
+      ...(effectiveAt && form.date !== todayInBogota() ? { effectiveAt } : {}),
+      ...(form.kind === 'TRANSFER' ? { toAccountId: form.toAccountId } : {}),
+      ...(form.kind === 'ADJUSTMENT' ? { direction: form.direction } : {}),
+      ...(form.kind === 'EXPENSE' && form.categoryId ? { categoryId: form.categoryId } : {}),
+      ...(form.kind === 'OTHER_INCOME' ? { excludeFromProfit: form.excludeFromProfit } : {}),
+      ...(form.description.trim() ? { description: form.description.trim() } : {}),
+      ...(proofS3Key ? { proofS3Key } : {}),
+    });
+    setBusy(false);
+    if (!res.success) {
+      setError(errorText(t, res));
+      return;
+    }
+    onSaved();
+  };
+
+  return (
+    <div className="fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4" role="presentation">
+      <form
+        noValidate
+        onSubmit={submit}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={id('title')}
+        className="bg-white rounded-[var(--radius-xl)] p-6 w-full max-w-lg shadow-xl flex flex-col gap-3 max-h-[90vh] overflow-y-auto"
+      >
+        <h2 id={id('title')} className={`text-lg font-semibold ${INK}`}>{t('admin.finance.entryForm.title')}</h2>
+        {error && <p role="alert" className={ERROR_BOX}>{error}</p>}
+
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('kind')} className={LABEL}>{t('admin.finance.entryForm.kind')}</label>
+          <select id={id('kind')} value={form.kind} onChange={(e) => set('kind', e.target.value)} className={INPUT}>
+            {KINDS.map((k) => <option key={k} value={k}>{t(`admin.finance.types.${k}`)}</option>)}
+          </select>
+          <p className={HINT}>{t(`admin.finance.entryForm.kindHints.${form.kind}`)}</p>
+        </div>
+
+        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
+          <div className="flex flex-col gap-1 min-w-0">
+            <label htmlFor={id('account')} className={LABEL}>
+              {t(form.kind === 'TRANSFER' ? 'admin.finance.entryForm.fromAccount' : 'admin.finance.entryForm.account')}
+            </label>
+            <select id={id('account')} value={form.accountId} onChange={(e) => set('accountId', e.target.value)} className={INPUT}>
+              <option value="">{t('admin.finance.transfer.accountPlaceholder')}</option>
+              {accounts.map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}
+            </select>
+          </div>
+          {form.kind === 'TRANSFER' && (
+            <div className="flex flex-col gap-1 min-w-0">
+              <label htmlFor={id('to')} className={LABEL}>{t('admin.finance.entryForm.toAccount')}</label>
+              <select id={id('to')} value={form.toAccountId} onChange={(e) => set('toAccountId', e.target.value)} className={INPUT}>
+                <option value="">{t('admin.finance.transfer.accountPlaceholder')}</option>
+                {accounts.filter((a) => a.id !== form.accountId).map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}
+              </select>
+            </div>
+          )}
+          <div className="flex flex-col gap-1 min-w-0">
+            <label htmlFor={id('amount')} className={LABEL}>{t('admin.finance.entryForm.amount')}</label>
+            <input
+              id={id('amount')} type="number" inputMode="decimal" min={0} step="any"
+              value={form.amount} onChange={(e) => set('amount', e.target.value)} className={INPUT}
+            />
+          </div>
+          {form.kind !== 'OPENING_BALANCE' && (
+            <div className="flex flex-col gap-1 min-w-0">
+              <label htmlFor={id('date')} className={LABEL}>{t('admin.finance.entryForm.date')}</label>
+              <input
+                id={id('date')} type="date" max={todayInBogota()}
+                value={form.date} onChange={(e) => set('date', e.target.value)} className={INPUT}
+              />
+            </div>
+          )}
+          {form.kind === 'ADJUSTMENT' && (
+            <div className="flex flex-col gap-1 min-w-0">
+              <label htmlFor={id('direction')} className={LABEL}>{t('admin.finance.entryForm.direction')}</label>
+              <select id={id('direction')} value={form.direction} onChange={(e) => set('direction', e.target.value)} className={INPUT}>
+                <option value="IN">{t('admin.finance.directions.IN')}</option>
+                <option value="OUT">{t('admin.finance.directions.OUT')}</option>
+              </select>
+            </div>
+          )}
+          {form.kind === 'EXPENSE' && (
+            <div className="flex flex-col gap-1 min-w-0">
+              <label htmlFor={id('category')} className={LABEL}>{t('admin.finance.entryForm.category')}</label>
+              <select id={id('category')} value={form.categoryId} onChange={(e) => set('categoryId', e.target.value)} className={INPUT}>
+                <option value="">{t('admin.finance.entryForm.categoryPlaceholder')}</option>
+                {categories.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
+              </select>
+            </div>
+          )}
+        </div>
+
+        {form.kind === 'OTHER_INCOME' && (
+          <label className={`flex items-center gap-2 text-sm ${INK}`}>
+            <input
+              type="checkbox" checked={form.excludeFromProfit}
+              onChange={(e) => set('excludeFromProfit', e.target.checked)}
+              className="w-4 h-4 accent-[var(--calico-orange)]"
+            />
+            {t('admin.finance.entryForm.excludeFromProfit')}
+          </label>
+        )}
+
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('description')} className={LABEL}>
+            {t(form.kind === 'ADJUSTMENT' ? 'admin.finance.entryForm.reason' : 'admin.finance.entryForm.description')}
+          </label>
+          <input
+            id={id('description')} type="text" maxLength={500}
+            value={form.description} onChange={(e) => set('description', e.target.value)} className={INPUT}
+          />
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <label htmlFor={id('proof')} className={LABEL}>
+            {t(proofRequired ? 'admin.finance.transfer.proof' : 'admin.finance.entryForm.proofOptional')}
+          </label>
+          <input
+            id={id('proof')} type="file" accept={FINANCE_PROOF_ACCEPT}
+            onChange={(e) => set('file', e.target.files?.[0] ?? null)}
+            className={`text-sm ${INK}`}
+          />
+          <p className={HINT}>{t('admin.finance.transfer.proofHint')}</p>
+        </div>
+
+        <div className="flex justify-end gap-2 mt-2">
+          <Button type="button" variant="outline" onClick={onClose} disabled={busy}>{t('admin.tutorDetail.modals.common.cancel')}</Button>
+          <Button type="submit" variant="cta" disabled={busy}>
+            {busy ? t('admin.tutorDetail.modals.common.processing') : t('admin.finance.entryForm.submit')}
+          </Button>
+        </div>
+      </form>
+    </div>
+  );
+}
diff --git a/src/app/home/admin/finanzas/_components/RefundsTab.jsx b/src/app/home/admin/finanzas/_components/RefundsTab.jsx
new file mode 100644
index 0000000..fc26833
--- /dev/null
+++ b/src/app/home/admin/finanzas/_components/RefundsTab.jsx
@@ -0,0 +1,217 @@
+'use client';
+
+import { useCallback, useEffect, useId, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { AdminFinanceService } from '@/app/services/core/AdminFinanceService';
+import { useI18n } from '@/lib/i18n';
+import ConfirmDialog from '../../eventos/_components/ConfirmDialog';
+import {
+  CARD, CHIP, ERROR_BOX, HINT, INK, INPUT, LABEL, MUTED, TABLE_WRAP, TD, TH, TONE, TR,
+} from '../../eventos/_components/ui';
+import TransferFields, { buildTransfer, emptyTransfer } from './TransferFields';
+import { errorText } from './format';
+
+/**
+ * Tutoring payments of sessions that were canceled or rejected and not
+ * refunded yet, plus the refunds already made. Refunds of repasos stay in
+ * each event's Payments tab.
+ */
+export default function RefundsTab() {
+  const { t, formatCurrency, formatDate } = useI18n();
+  const money = (n) => formatCurrency(n ?? 0, 'COP');
+  const uid = useId();
+  const id = (n) => `${uid}-${n}`;
+  const [data, setData] = useState({ status: 'loading', pending: [], refunded: [], error: null });
+  const [refunding, setRefunding] = useState(null);
+  const [amount, setAmount] = useState('');
+  const [reason, setReason] = useState('');
+  const [transfer, setTransfer] = useState(emptyTransfer);
+  const [busy, setBusy] = useState(false);
+  const [dialogError, setDialogError] = useState(null);
+
+  const apply = useCallback((res) => {
+    setData(res.success
+      ? { status: 'ready', pending: res.pending, refunded: res.refunded, error: null }
+      : { status: 'error', pending: [], refunded: [], error: errorText(t, res) });
+  }, [t]);
+
+  const load = useCallback(() => AdminFinanceService.listSessionRefunds().then(apply), [apply]);
+
+  useEffect(() => {
+    let ignore = false;
+    AdminFinanceService.listSessionRefunds().then((res) => { if (!ignore) apply(res); });
+    return () => { ignore = true; };
+  }, [apply]);
+
+  const close = () => {
+    setRefunding(null);
+    setAmount('');
+    setReason('');
+    setDialogError(null);
+    setTransfer((prev) => ({ ...emptyTransfer(), accountId: prev.accountId }));
+  };
+
+  const confirm = async () => {
+    const partial = amount.trim() === '' ? null : Number(amount);
+    if (partial !== null && (!Number.isFinite(partial) || partial <= 0 || partial > refunding.amount)) {
+      setDialogError(t('admin.finance.refund.amountInvalid'));
+      return;
+    }
+    if (!reason.trim()) {
+      setDialogError(t('admin.finance.rules.REASON_REQUIRED'));
+      return;
+    }
+    setBusy(true);
+    setDialogError(null);
+    const built = await buildTransfer(transfer);
+    if (!built.ok) {
+      setBusy(false);
+      setDialogError(t(built.errorKey));
+      return;
+    }
+    const res = await AdminFinanceService.refundSessionPayment({
+      paymentId: refunding.paymentId,
+      ...(partial !== null ? { amount: partial } : {}),
+      reason: reason.trim(),
+      accountId: built.transfer.accountId,
+      refundedAt: built.transfer.paidAt,
+      ...(built.transfer.proofS3Key ? { proofS3Key: built.transfer.proofS3Key } : {}),
+    });
+    setBusy(false);
+    if (!res.success) {
+      setDialogError(errorText(t, res));
+      return;
+    }
+    close();
+    await load();
+  };
+
+  const sessionCell = (r) => (
+    <td className={`${TD} ${INK}`}>
+      <div>{r.session?.course?.name}</div>
+      <div className={`text-xs ${MUTED}`}>
+        {formatDate(r.session?.startTimestamp, { day: 'numeric', month: 'short', year: 'numeric' })}
+        {' · '}{r.tutor?.name}
+      </div>
+    </td>
+  );
+
+  if (data.status === 'loading') return <p className={`text-sm ${MUTED}`}>{t('common.loading')}</p>;
+  if (data.status === 'error') return <p className={ERROR_BOX}>{data.error}</p>;
+
+  return (
+    <div className="flex flex-col gap-5">
+      <section className="flex flex-col gap-2">
+        <h2 className={`text-sm font-bold ${INK}`}>{t('admin.finance.refunds.pendingTitle')}</h2>
+        <p className={`text-xs ${MUTED}`}>{t('admin.finance.refunds.pendingHint')}</p>
+        {data.pending.length === 0 ? (
+          <p className={`${CARD} p-5 text-sm ${MUTED}`}>{t('admin.finance.refunds.pendingEmpty')}</p>
+        ) : (
+          <div className={TABLE_WRAP}>
+            <table className="w-full text-sm">
+              <thead>
+                <tr>
+                  <th className={TH}>{t('admin.finance.refunds.columns.session')}</th>
+                  <th className={TH}>{t('admin.finance.refunds.columns.student')}</th>
+                  <th className={TH}>{t('admin.finance.refunds.columns.status')}</th>
+                  <th className={`${TH} text-right`}>{t('admin.finance.refunds.columns.charged')}</th>
+                  <th className={TH} />
+                </tr>
+              </thead>
+              <tbody>
+                {data.pending.map((r) => (
+                  <tr key={r.paymentId} className={TR}>
+                    {sessionCell(r)}
+                    <td className={`${TD} ${INK}`}>
+                      <div>{r.student?.name}</div>
+                      <div className={`text-xs ${MUTED}`}>{r.student?.email}</div>
+                    </td>
+                    <td className={TD}>
+                      <span className={`${CHIP} ${TONE.warning}`}>{r.session?.status}</span>
+                      {r.tutorAlreadyPaid && <p className={`${HINT} mt-1`}>{t('admin.finance.refunds.tutorAlreadyPaid')}</p>}
+                    </td>
+                    <td className={`${TD} text-right whitespace-nowrap font-semibold ${INK}`}>{money(r.amount)}</td>
+                    <td className={TD}>
+                      <Button size="sm" variant="outline" onClick={() => setRefunding(r)}>{t('admin.finance.refunds.refund')}</Button>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+
+      <section className="flex flex-col gap-2">
+        <h2 className={`text-sm font-bold ${INK}`}>{t('admin.finance.refunds.doneTitle')}</h2>
+        {data.refunded.length === 0 ? (
+          <p className={`${CARD} p-5 text-sm ${MUTED}`}>{t('admin.finance.refunds.doneEmpty')}</p>
+        ) : (
+          <div className={TABLE_WRAP}>
+            <table className="w-full text-sm">
+              <thead>
+                <tr>
+                  <th className={TH}>{t('admin.finance.refunds.columns.session')}</th>
+                  <th className={TH}>{t('admin.finance.refunds.columns.reason')}</th>
+                  <th className={TH}>{t('admin.finance.refunds.columns.refundedAt')}</th>
+                  <th className={`${TH} text-right`}>{t('admin.finance.refunds.columns.refunded')}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {data.refunded.map((r) => (
+                  <tr key={r.paymentId} className={TR}>
+                    {sessionCell(r)}
+                    <td className={`${TD} text-xs ${MUTED}`}>{r.refundReason || '—'}</td>
+                    <td className={`${TD} whitespace-nowrap text-xs ${MUTED}`}>
+                      {r.refundedAt ? formatDate(r.refundedAt, { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
+                    </td>
+                    <td className={`${TD} text-right whitespace-nowrap font-semibold ${INK}`}>
+                      {money(r.refundAmount ?? r.amount)}
+                      {r.refundAmount != null && r.refundAmount < r.amount && (
+                        <div className={`text-xs ${MUTED}`}>{t('admin.finance.refunds.ofCharged', { amount: money(r.amount) })}</div>
+                      )}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+
+      <ConfirmDialog
+        open={Boolean(refunding)}
+        title={t('admin.finance.refunds.dialogTitle')}
+        message={refunding && t('admin.finance.refunds.dialogBody', {
+          amount: money(refunding.amount),
+          name: refunding.student?.name || refunding.student?.email || '—',
+        })}
+        confirmLabel={t('admin.finance.refunds.refund')}
+        busy={busy}
+        error={dialogError}
+        onConfirm={confirm}
+        onCancel={close}
+      >
+        <div className="flex flex-col gap-3 mt-3">
+          <div className="flex flex-col gap-1">
+            <label htmlFor={id('amount')} className={LABEL}>{t('admin.finance.refund.amount')}</label>
+            <input
+              id={id('amount')} type="number" inputMode="numeric" min={1} step={1}
+              value={amount} onChange={(e) => setAmount(e.target.value)}
+              placeholder={refunding ? String(refunding.amount) : ''} disabled={busy} className={INPUT}
+            />
+            <p className={HINT}>{t('admin.finance.refund.amountHint')}</p>
+          </div>
+          <div className="flex flex-col gap-1">
+            <label htmlFor={id('reason')} className={LABEL}>{t('admin.finance.refunds.reason')}</label>
+            <input
+              id={id('reason')} type="text" maxLength={500}
+              value={reason} onChange={(e) => setReason(e.target.value)} disabled={busy} className={INPUT}
+            />
+          </div>
+          <TransferFields value={transfer} onChange={setTransfer} disabled={busy} />
+        </div>
+      </ConfirmDialog>
+    </div>
+  );
+}
diff --git a/src/app/home/admin/finanzas/_components/SettingsTab.jsx b/src/app/home/admin/finanzas/_components/SettingsTab.jsx
new file mode 100644
index 0000000..f470146

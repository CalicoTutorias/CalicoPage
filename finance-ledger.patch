 @@map(\"careers\")\n}\n\n// ─── AUTH PROVIDER ENUM ───────────────────────────────────────────────\n\nenum AuthProviderEnum {\n  Local\n  Google\n}\n\nenum UserKind {\n  Registered\n  ExternalTemporary\n}\n\nenum SessionSourceEnum {\n  Platform\n  ManualAdmin\n}\n\n// ─── USER ROLE ────────────────────────────────────────────────────────\n// Base role of the user. Orthogonal to `isTutorApproved` — an admin can\n// also be an approved tutor if needed. New roles (MODERATOR, SUPPORT…)\n// can be added without schema changes elsewhere.\nenum Role {\n  STUDENT\n  ADMIN\n}\n\n// ─── USERS ────────────────────────────────────────────────────────────\n\n// ─── EVENTOS (repasos grupales) ───────────────────────────────────────\nenum EventStatusEnum {\n  Draft\n  Published\n  Canceled\n}\n\nenum EventModalityEnum {\n  Virtual\n  InPerson\n}\n\n// PendingApproval / Rejected: only on events with requiresApproval (payment\n// coordinated outside the platform; an admin approves or rejects each row).\nenum EventRegistrationStatusEnum {\n  PendingPayment\n  PendingApproval\n  Confirmed\n  Rejected\n  Canceled\n}\n\nenum EventPaymentFlagEnum {\n  DUPLICATE\n  EVENT_CANCELED\n  REGISTRATION_CANCELED\n  EARLY_BIRD_OVERRUN\n}\n\nenum EventRefundStatusEnum {\n  None\n  Pending\n  Refunded\n}\n\nenum PaymentIntentKindEnum {\n  session\n  event\n}\n\nmodel User {\n  id                    String  @id @default(uuid())\n  email                 String  @unique\n  passwordHash          String? @map(\"password_hash\")\n  name                  String\n  phoneNumber           String? @map(\"phone_number\")\n  phoneNumberNormalized String? @unique @map(\"phone_number_normalized\")\n  // Usuario de WhatsApp sin la @, escrito por un admin en una tutoría manual.\n  // Dato interno de contacto: no es único ni identifica a nadie, y\n  // user.repository lo quita de las lecturas genéricas.\n  whatsappTag           String? @map(\"whatsapp_tag\")\n  profilePictureUrl     String? @map(\"profile_picture_url\")\n  careerId              String? @map(\"career_id\")\n\n  // OAuth fields\n  authProvider AuthProviderEnum @default(Local) @map(\"auth_provider\")\n  googleId     String?          @unique @map(\"google_id\")\n\n  // Roles y estado\n  role             Role     @default(STUDENT)\n  kind             UserKind @default(Registered)\n  isTutorRequested Boolean  @default(false) @map(\"is_tutor_requested\")\n  isTutorApproved  Boolean  @default(false) @map(\"is_tutor_approved\")\n  isActive         Boolean  @default(true) @map(\"is_active\")\n  isEmailVerified  Boolean  @default(false) @map(\"is_email_verified\")\n\n  // Incremented on password change/reset to invalidate previously-issued JWTs.\n  // Column already exists in the DB (migration 20260613000000) but was never\n  // declared here, so Prisma silently dropped every read/write of it.\n  tokenVersion Int @default(0) @map(\"token_version\")\n\n  // Moderación (suspensión por mala conducta o ratings bajos)\n  suspendedAt     DateTime? @map(\"suspended_at\")\n  suspendedReason String?   @map(\"suspended_reason\")\n  suspendedById   String?   @map(\"suspended_by_id\")\n\n  // Terms and conditions\n  terms            Boolean   @default(false)\n  marketingOptInAt DateTime? @map(\"marketing_opt_in_at\")\n\n  // Tokens de verificación y reset\n  verificationToken       String?   @map(\"verification_token\")\n  verificationTokenExpiry DateTime? @map(\"verification_token_expiry\")\n  resetToken              String?   @map(\"reset_token\")\n  resetTokenExpiry        DateTime? @map(\"reset_token_expiry\")\n  otpCode                 String?   @map(\"otp_code\")\n  otpCodeExpiry           DateTime? @map(\"otp_code_expiry\")\n  // Failed OTP verification attempts for the current code. Reset to 0 when a\n  // fresh OTP is issued; once it hits the cap the code is invalidated to stop\n  // brute-forcing the 6-digit OTP (server-side, survives across instances).\n  otpAttempts             Int       @default(0) @map(\"otp_attempts\")\n\n  // Última vez que el usuario estuvo en la app (\"last seen\"). Se usa para\n  // métricas de engagement (usuarios activos en la última semana). Como la\n  // sesión JWT persiste, NO basta con el login: se refresca también en el\n  // heartbeat /api/auth/me (con throttle). Best-effort / fire-and-forget.\n  lastSeenAt DateTime? @map(\"last_seen_at\")\n\n  // Calificación como ESTUDIANTE (tutores → estudiante, estilo Uber).\n  // Agregado denormalizado de student_reviews con status 'done' — mismo\n  // patrón que TutorProfile.review/numReview. PRIVADA: visible solo para\n  // tutores con una sesión vinculada a este estudiante, para admins y para\n  // el propio estudiante (solo el número, nunca los comentarios).\n  studentRating      Decimal @default(0) @map(\"student_rating\") @db.Decimal(3, 2)\n  studentRatingCount Int     @default(0) @map(\"student_rating_count\")\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  // Relaciones\n  career                    Career?                    @relation(fields: [careerId], references: [id])\n  tutorProfile              TutorProfile?\n  schedule                  Schedule?                  @relation(\"UserSchedule\")\n  googleCalendarCredential  GoogleCalendarCredential?\n  availabilities            Availability[]\n  tutorSessions             Session[]                  @relation(\"TutorSessions\")\n  participations            SessionParticipant[]\n  reviewsWritten            Review[]                   @relation(\"ReviewsWritten\")\n  eventsCreated             Event[]                    @relation(\"EventCreator\")\n  eventTutoring             EventTutor[]               @relation(\"EventTutoring\")\n  eventRegistrations        EventRegistration[]        @relation(\"EventRegistrations\")\n  eventTutorPayouts         EventTutorPayout[]         @relation(\"EventTutorPayouts\")\n  reviewsReceived           Review[]                   @relation(\"ReviewsReceived\")\n  studentReviewsWritten     StudentReview[]            @relation(\"StudentReviewsWritten\")\n  studentReviewsReceived    StudentReview[]            @relation(\"StudentReviewsReceived\")\n  paymentsAsStudent         Payment[]                  @relation(\"PaymentsStudent\")\n  paymentsAsTutor           Payment[]                  @relation(\"PaymentsTutor\")\n  tutorApplications         TutorApplication[]\n  notifications             Notification[]\n  courseNotifySubscriptions CourseNotifySubscription[]\n\n  // Moderación: quién suspendió a este usuario (self-relation)\n  suspendedBy    User?  @relation(\"UserSuspendedBy\", fields: [suspendedById], references: [id])\n  suspendedUsers User[] @relation(\"UserSuspendedBy\")\n\n  // Aplicaciones de tutor revisadas por este admin\n  applicationsReviewed TutorApplication[] @relation(\"ApplicationReviewedBy\")\n\n  // Acciones admin ejecutadas por este usuario\n  adminActions                AdminAuditLog[]       @relation(\"AdminActor\")\n  manualSessionsCreated       Session[]             @relation(\"ManualSessionCreator\")\n  courseSuggestionsRequested  CourseSuggestion[]    @relation(\"CourseSuggestionRequester\")\n  courseSuggestionsReviewed   CourseSuggestion[]    @relation(\"CourseSuggestionReviewer\")\n  newsPosts                   NewsPost[]            @relation(\"NewsAuthor\")\n  couponsCreated              Coupon[]              @relation(\"CouponCreator\")\n  couponRedemptions           CouponRedemption[]    @relation(\"CouponRedemptions\")\n  marketingPiecesCreated      MarketingPiece[]      @relation(\"MarketingPieceCreator\")\n  marketingPiecesUpdated      MarketingPiece[]      @relation(\"MarketingPieceUpdater\")\n  marketingPiecesPublished    MarketingPiece[]      @relation(\"MarketingPiecePublisher\")\n  marketingPiecesOnInstagram  MarketingPiece[]      @relation(\"MarketingPieceInstagramPublisher\")\n  marketingPlansCreated       MarketingPlan[]       @relation(\"MarketingPlanCreator\")\n  marketingPlansUpdated       MarketingPlan[]       @relation(\"MarketingPlanUpdater\")\n  marketingPlanEntriesCreated MarketingPlanEntry[]  @relation(\"MarketingPlanEntryCreator\")\n  marketingPlanEntriesUpdated MarketingPlanEntry[]  @relation(\"MarketingPlanEntryUpdater\")\n  contentCreatorTokens        ContentCreatorToken[]\n\n  @@map(\"users\")\n}\n\nmodel TutorProfile {\n  userId                String        @id @map(\"user_id\")\n  schoolEmail           String        @unique @map(\"school_email\")\n  experienceYears       Int?          @map(\"experience_years\")\n  credits               Int           @default(0)\n  experienceDescription String?       @map(\"experience_description\")\n  updatedAt             DateTime      @updatedAt @map(\"updated_at\")\n  review                Decimal       @default(0) @db.Decimal(3, 2)\n  numReview             Int           @default(0) @map(\"num_review\")\n  numSessions           Int           @default(0) @map(\"num_sessions\")\n  nextPayment           Decimal       @default(0) @map(\"next_payment\") @db.Decimal(12, 2)\n  totalEarning          Decimal       @default(0) @map(\"total_earning\") @db.Decimal(12, 2)\n  // 2000 = TUTOR_BIO_MAX_LENGTH en src/config/profile.js y el max() de Zod en\n  // /api/tutor/profile. Los tres tienen que moverse juntos.\n  bio                   String?       @map(\"bio\") @db.VarChar(2000)\n  llave                 String?\n  tutorCourses          TutorCourse[]\n  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"tutor_profiles\")\n}\n\nmodel Course {\n  id                  String                     @id @default(uuid())\n  name                String\n  code                String                     @unique\n  basePrice           Decimal                    @map(\"base_price\") @db.Decimal(10, 2)\n  complexity          ComplexityEnum\n  aliases             String[]                   @default([])\n  careerId            String                     @map(\"career_id\")\n  career              Career                     @relation(fields: [careerId], references: [id])\n  reviews             Review[]\n  events              Event[]\n  sessions            Session[]\n  tutorCourses        TutorCourse[]\n  suggestions         CourseSuggestion[]\n  notifySubscriptions CourseNotifySubscription[]\n\n  @@index([careerId])\n  @@map(\"courses\")\n}\n\nmodel CourseNotifySubscription {\n  id                String    @id @default(uuid())\n  studentId         String    @map(\"student_id\")\n  courseId          String    @map(\"course_id\")\n  notificationEmail String    @map(\"notification_email\")\n  source            String    @default(\"unknown\")\n  notifiedAt        DateTime? @map(\"notified_at\")\n  cancelledAt       DateTime? @map(\"cancelled_at\")\n  createdAt         DateTime  @default(now()) @map(\"created_at\")\n  updatedAt         DateTime  @updatedAt @map(\"updated_at\")\n\n  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)\n  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)\n\n  @@index([courseId, notifiedAt, cancelledAt])\n  @@index([studentId, courseId])\n  @@map(\"course_notify_subscriptions\")\n}\n\nmodel CourseSuggestion {\n  id           String                     @id @default(uuid())\n  code         String\n  name         String\n  notes        String?\n  status       CourseSuggestionStatusEnum @default(Pending)\n  requesterId  String?                    @map(\"requester_id\")\n  reviewedById String?                    @map(\"reviewed_by_id\")\n  reviewedAt   DateTime?                  @map(\"reviewed_at\")\n  courseId     String?                    @map(\"course_id\")\n  createdAt    DateTime                   @default(now()) @map(\"created_at\")\n  updatedAt    DateTime                   @updatedAt @map(\"updated_at\")\n\n  requester  User?   @relation(\"CourseSuggestionRequester\", fields: [requesterId], references: [id], onDelete: SetNull)\n  reviewedBy User?   @relation(\"CourseSuggestionReviewer\", fields: [reviewedById], references: [id], onDelete: SetNull)\n  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)\n\n  @@index([status, createdAt])\n  @@index([code])\n  @@map(\"course_suggestions\")\n}\n\nmodel TutorCourse {\n  tutorId       String                @map(\"tutor_id\")\n  courseId      String                @map(\"course_id\")\n  experience    String?               @map(\"experience\")\n  workSampleUrl String?               @map(\"work_sample_url\")\n  status        TutorCourseStatusEnum @default(Pending)\n  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  tutor         TutorProfile          @relation(fields: [tutorId], references: [userId], onDelete: Cascade)\n\n  @@id([tutorId, courseId])\n  @@map(\"tutor_courses\")\n}\n\nmodel Schedule {\n  id                String  @id @default(uuid())\n  userId            String  @unique @map(\"user_id\")\n  timezone          String  @default(\"America/Bogota\")\n  autoAcceptSession Boolean @default(false) @map(\"auto_accept_session\")\n  minBookingNotice  Int     @default(24) @map(\"min_booking_notice\")\n  maxSessionsPerDay Int     @default(5) @map(\"max_sessions_per_day\")\n  bufferTime        Int     @default(15) @map(\"buffer_time\")\n  calendarSyncId    String? @map(\"calendar_sync_id\")\n  calendarSyncMode  String? @default(\"available\") @map(\"calendar_sync_mode\")\n\n  // Estado de la integración con Google Calendar. Los tokens OAuth viven solo\n  // en cookies HttpOnly del navegador del tutor, así que el servidor (y el\n  // panel admin) no puede saber si sigue conectado: estas columnas son la\n  // única señal persistida. `calendarConnectedAt` se escribe al elegir\n  // calendario y se limpia al desconectar; las otras dos, en cada sync.\n  calendarConnectedAt  DateTime? @map(\"calendar_connected_at\")\n  calendarLastSyncedAt DateTime? @map(\"calendar_last_synced_at\")\n  calendarLastSyncOk   Boolean?  @map(\"calendar_last_sync_ok\")\n\n  user User @relation(\"UserSchedule\", fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"schedules\")\n}\n\n// Credenciales OAuth de Google Calendar del tutor, persistidas para que la\n// conexión sobreviva al navegador (antes: cookies HttpOnly de 30 días en un\n// solo dispositivo). Los tokens van cifrados con AES-256-GCM\n// (src/lib/security/secret-box.js) y NUNCA salen del repositorio en claro:\n// `google-calendar-credential.repository` solo expone `toSummary()` hacia\n// fuera; el descifrado ocurre dentro de `calendar-credential.service`.\n// Desconectar borra la fila. `revokedAt` marca que Google rechazó el refresh\n// token (invalid_grant): la fila se conserva para que la UI explique por qué\n// hay que reconectar, y la siguiente conexión la reemplaza.\nmodel GoogleCalendarCredential {\n  userId                String    @id @map(\"user_id\")\n  refreshTokenEncrypted String    @map(\"refresh_token_encrypted\")\n  accessTokenEncrypted  String?   @map(\"access_token_encrypted\")\n  accessTokenExpiresAt  DateTime? @map(\"access_token_expires_at\")\n  scope                 String?\n  revokedAt             DateTime? @map(\"revoked_at\")\n  revokedReason         String?   @map(\"revoked_reason\")\n  createdAt             DateTime  @default(now()) @map(\"created_at\")\n  updatedAt             DateTime  @updatedAt @map(\"updated_at\")\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"google_calendar_credentials\")\n}\n\nmodel Availability {\n  id           String    @id @default(uuid())\n  dayOfWeek    Int       @map(\"day_of_week\")\n  endTime      DateTime  @map(\"end_time\") @db.Time(6)\n  startTime    DateTime  @map(\"start_time\") @db.Time(6)\n  userId       String    @map(\"user_id\")\n  label        String?   @map(\"label\") @db.VarChar(160)\n  recurring    Boolean   @default(true) @map(\"recurring\")\n  specificDate DateTime? @map(\"specific_date\") @db.Date\n  source       String    @default(\"manual\") @map(\"source\")\n  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"availabilities\")\n}\n\nmodel Session {\n  id                String            @id @default(uuid())\n  courseId          String            @map(\"course_id\")\n  tutorId           String            @map(\"tutor_id\")\n  sessionType       SessionTypeEnum   @map(\"session_type\")\n  maxCapacity       Int               @default(1) @map(\"max_capacity\")\n  startTimestamp    DateTime          @map(\"start_timestamp\")\n  endTimestamp      DateTime          @map(\"end_timestamp\")\n  status            SessionStatusEnum @default(Pending)\n  locationType      LocationTypeEnum  @map(\"location_type\")\n  notes             String?\n  topicsToReview    String?           @map(\"topics_to_review\")\n  source            SessionSourceEnum @default(Platform)\n  manualCreatedById String?           @map(\"manual_created_by_id\")\n  createdAt         DateTime          @default(now()) @map(\"created_at\")\n\n  // Google Calendar integration\n  googleCalendarEventId String? @map(\"google_calendar_event_id\")\n  googleMeetLink        String? @map(\"google_meet_link\")\n\n  // Cancellation tracking\n  cancellationReason  String?   @map(\"cancellation_reason\")\n  cancelledAt         DateTime? @map(\"cancelled_at\")\n  cancelledBy         String?   @map(\"cancelled_by\")\n  refundMethod        String?   @map(\"refund_method\") // 'bank_transfer', 'nequi', 'use_future_session', etc.\n  refundMethodDetails String?   @map(\"refund_method_details\") // Additional info (bank account, etc.)\n\n  course            Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)\n  tutor             User                 @relation(\"TutorSessions\", fields: [tutorId], references: [id], onDelete: Restrict)\n  manualCreatedBy   User?                @relation(\"ManualSessionCreator\", fields: [manualCreatedById], references: [id], onDelete: SetNull)\n  participants      SessionParticipant[]\n  payments          Payment[]\n  reviews           Review[]\n  studentReviews    StudentReview[]\n  notifications     Notification[]\n  attachments       SessionAttachment[]\n  materials         SessionMaterial[]\n  couponRedemptions CouponRedemption[]\n\n  @@index([tutorId, status, startTimestamp(sort: Desc)])\n  @@map(\"sessions\")\n}\n\nmodel SessionAttachment {\n  id         String   @id @default(uuid())\n  sessionId  String   @map(\"session_id\")\n  s3Key      String   @map(\"s3_key\")\n  fileName   String   @map(\"file_name\")\n  fileSize   Int      @map(\"file_size\")\n  mimeType   String   @map(\"mime_type\")\n  uploadedAt DateTime @default(now()) @map(\"uploaded_at\")\n  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n\n  @@index([sessionId])\n  @@map(\"session_attachments\")\n}\n\n// Material de estudio de una tutoría: lo suben el tutor o un admin para el\n// estudiante, al revés que SessionAttachment (del estudiante para el tutor). El\n// estudiante solo lo descarga tras dejar su reseña con comentario. Archivos en un\n// prefijo privado de S3; las reglas están en session-material.service.js.\nmodel SessionMaterial {\n  id          String   @id @default(uuid())\n  sessionId   String   @map(\"session_id\")\n  s3Key       String   @map(\"s3_key\")\n  fileName    String   @map(\"file_name\")\n  mimeType    String   @map(\"mime_type\")\n  fileSize    Int      @map(\"file_size\")\n  createdById String?  @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, s3Key])\n  @@index([sessionId, createdAt])\n  @@map(\"session_materials\")\n}\n\nmodel SessionParticipant {\n  sessionId        String   @map(\"session_id\")\n  studentId        String   @map(\"student_id\")\n  joinedAt         DateTime @default(now()) @map(\"joined_at\")\n  participantCount Int      @default(1) @map(\"participant_count\")\n  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)\n\n  @@id([sessionId, studentId])\n  @@index([studentId, sessionId])\n  @@map(\"session_participants\")\n}\n\nmodel Review {\n  id          String           @id @default(uuid())\n  rating      Int?\n  tutorId     String           @map(\"tutor_id\")\n  studentId   String           @map(\"student_id\")\n  // Arco exclusivo: una reseña es de una sesión O de un evento\n  // (CHECK reviews_session_xor_event en prisma/sql/).\n  sessionId   String?          @map(\"session_id\")\n  eventId     String?          @map(\"event_id\")\n  comment     String?\n  status      ReviewStatusEnum @default(pending)\n  // When the student rated. Not a created_at: a session's row is an empty\n  // placeholder long before that. Set once; editing a review does not move it.\n  submittedAt DateTime?        @map(\"submitted_at\")\n  courseId    String?          @map(\"course_id\")\n  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Restrict)\n  session     Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)\n  student     User             @relation(\"ReviewsWritten\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor       User             @relation(\"ReviewsReceived\", fields: [tutorId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, studentId, tutorId])\n  @@unique([eventId, studentId, tutorId])\n  @@index([tutorId, courseId, status])\n  @@index([eventId])\n  @@map(\"reviews\")\n}\n\n// Evento grupal (repaso). Precio fijo en COP (0 = gratis). \"Finalizado\" se\n// deriva de endsAt < now. Ver docs/superpowers/specs/2026-10-03-eventos-design.md\nmodel Event {\n  id                    String            @id @default(uuid())\n  slug                  String            @unique\n  title                 String\n  description           String\n  coverImageUrl         String?           @map(\"cover_image_url\")\n  courseId              String?           @map(\"course_id\")\n  startsAt              DateTime          @map(\"starts_at\")\n  endsAt                DateTime          @map(\"ends_at\")\n  // Hora por confirmar: startsAt/endsAt solo guardan el día (00:00–23:59\n  // Bogotá) y durationHours cuánto durará. El admin fija la hora después.\n  timeTbc               Boolean           @default(false) @map(\"time_tbc\")\n  durationHours         Float?            @map(\"duration_hours\")\n  modality              EventModalityEnum\n  autoMeet              Boolean           @default(false) @map(\"auto_meet\")\n  meetingUrl            String?           @map(\"meeting_url\")\n  // Grupo de WhatsApp en vez de Meet; solo lo ven los inscritos Confirmed.\n  whatsappUrl           String?           @map(\"whatsapp_url\")\n  location              String?\n  googleCalendarEventId String?           @map(\"google_calendar_event_id\")\n  price                 Decimal           @db.Decimal(10, 2)\n  earlyBirdSlots        Int?              @map(\"early_bird_slots\")\n  earlyBirdPercent      Int?              @map(\"early_bird_percent\")\n  isListed              Boolean           @default(true) @map(\"is_listed\")\n  // Registrations wait for an admin (PendingApproval) instead of being\n  // confirmed or paid through Wompi; `price` is then only informative.\n  requiresApproval      Boolean           @default(false) @map(\"requires_approval\")\n  // Private code of the post-event attendance link (/eventos/{slug}?asistencia=CODE),\n  // for a free event that took place without prior sign-ups. null = link closed.\n  attendanceCode        String?           @map(\"attendance_code\")\n  status                EventStatusEnum   @default(Draft)\n  publishedAt           DateTime?         @map(\"published_at\")\n  canceledAt            DateTime?         @map(\"canceled_at\")\n  cancelReason          String?           @map(\"cancel_reason\")\n  lastReminderAt        DateTime?         @map(\"last_reminder_at\")\n  createdById           String?           @map(\"created_by_id\")\n  createdAt             DateTime          @default(now()) @map(\"created_at\")\n  updatedAt             DateTime          @updatedAt @map(\"updated_at\")\n\n  course        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)\n  createdBy     User?               @relation(\"EventCreator\", fields: [createdById], references: [id], onDelete: SetNull)\n  tutors        EventTutor[]\n  registrations EventRegistration[]\n  tutorPayouts  EventTutorPayout[]\n  reviews       Review[]\n  materials     EventMaterial[]\n\n  @@index([status, isListed, startsAt])\n  @@map(\"events\")\n}\n\nmodel EventTutor {\n  eventId  String @map(\"event_id\")\n  tutorId  String @map(\"tutor_id\")\n  position Int    @default(0)\n\n  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)\n  tutor User  @relation(\"EventTutoring\", fields: [tutorId], references: [id], onDelete: Restrict)\n\n  @@id([eventId, tutorId])\n  @@index([tutorId])\n  @@map(\"event_tutors\")\n}\n\n// Una fila por (evento, usuario). PendingPayment = checkout abierto con una\n// reserva de 30 min (reservedAt); PendingApproval = espera a un admin\n// (eventos con requiresApproval); Confirmed = inscrito; Rejected = un admin\n// la rechazó; Canceled = cancelado.\nmodel EventRegistration {\n  id                  String                      @id @default(uuid())\n  eventId             String                      @map(\"event_id\")\n  userId              String                      @map(\"user_id\")\n  status              EventRegistrationStatusEnum\n  earlyBird           Boolean                     @default(false) @map(\"early_bird\")\n  reservedAt          DateTime?                   @map(\"reserved_at\")\n  listPrice           Decimal                     @map(\"list_price\") @db.Decimal(10, 2)\n  discountAmount      Decimal                     @default(0) @map(\"discount_amount\") @db.Decimal(10, 2)\n  finalAmount         Decimal                     @map(\"final_amount\") @db.Decimal(10, 2)\n  intentReference     String?                     @unique @map(\"intent_reference\")\n  source              String?\n  confirmedAt         DateTime?                   @map(\"confirmed_at\")\n  canceledAt          DateTime?                   @map(\"canceled_at\")\n  canceledBy          String?                     @map(\"canceled_by\")\n  refundMethod        String?                     @map(\"refund_method\")\n  refundMethodDetails String?                     @map(\"refund_method_details\")\n  surveyRemindedAt    DateTime?                   @map(\"survey_reminded_at\")\n  reviewedAt          DateTime?                   @map(\"reviewed_at\")\n  reviewedById        String?                     @map(\"reviewed_by_id\")\n  createdAt           DateTime                    @default(now()) @map(\"created_at\")\n  updatedAt           DateTime                    @updatedAt @map(\"updated_at\")\n\n  event          Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)\n  user           User                 @relation(\"EventRegistrations\", fields: [userId], references: [id], onDelete: Cascade)\n  payments       EventPayment[]\n  surveyResponse EventSurveyResponse?\n\n  @@unique([eventId, userId])\n  @@index([eventId, status, earlyBird])\n  @@index([userId, status])\n  @@map(\"event_registrations\")\n}\n\n// Cada transacción aprobada de Wompi para un evento. wompiId único = barrera\n// de idempotencia. flag != null → anomalía visible en admin.\nmodel EventPayment {\n  id             String                @id @default(uuid())\n  registrationId String                @map(\"registration_id\")\n  wompiId        String                @unique @map(\"wompi_id\")\n  reference      String\n  amount         Decimal               @db.Decimal(10, 2)\n  originalAmount Decimal               @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount Decimal               @map(\"discount_amount\") @db.Decimal(10, 2)\n  flag           EventPaymentFlagEnum?\n  refundStatus   EventRefundStatusEnum @default(None) @map(\"refund_status\")\n  refundedAt     DateTime?             @map(\"refunded_at\")\n  refundedById   String?               @map(\"refunded_by_id\")\n  createdAt      DateTime              @default(now()) @map(\"created_at\")\n\n  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)\n\n  @@index([registrationId])\n  @@index([refundStatus])\n  @@map(\"event_payments\")\n}\n\n// heardFrom / wouldRecommend: closed answers from src/lib/events/survey-questions.js\n// (plain strings, null on responses older than the questions).\nmodel EventSurveyResponse {\n  id              String   @id @default(uuid())\n  registrationId  String   @unique @map(\"registration_id\")\n  attended        Boolean\n  eventRating     Int?     @map(\"event_rating\")\n  heardFrom       String?  @map(\"heard_from\")\n  heardFromDetail String?  @map(\"heard_from_detail\")\n  wouldRecommend  String?  @map(\"would_recommend\")\n  submittedAt     DateTime @default(now()) @map(\"submitted_at\")\n\n  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)\n\n  @@map(\"event_survey_responses\")\n}\n\n// Material de estudio de un evento, en S3 privado bajo\n// event-materials/{curso}/{YYYY-MM-DD}_{slug}/. Solo lo descargan los\n// inscritos Confirmed que ya respondieron la encuesta (URL firmada).\nmodel EventMaterial {\n  id          String   @id @default(uuid())\n  eventId     String   @map(\"event_id\")\n  // Uploaded file: a key in AWS_S3_BUCKET, owned by this row. File of a post\n  // (postSlug set): a key in AWS_S3_POSTS_BUCKET, owned by the post. It is never\n  // copied, and removing the material leaves it in place. External link (url set,\n  // e.g. the recording): there is no file, so s3Key, mimeType and fileSize are\n  // null and fileName is the name the admin typed. A CHECK in the database\n  // requires exactly one of s3Key and url.\n  s3Key       String?  @map(\"s3_key\")\n  postSlug    String?  @map(\"post_slug\")\n  url         String?\n  fileName    String   @map(\"file_name\")\n  mimeType    String?  @map(\"mime_type\")\n  fileSize    Int?     @map(\"file_size\")\n  createdById String?  @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n\n  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)\n\n  @@unique([eventId, s3Key])\n  @@unique([eventId, url])\n  @@index([eventId, createdAt])\n  @@index([postSlug])\n  @@map(\"event_materials\")\n}\n\n// Pago al tutor hecho por fuera de la plataforma; solo trazabilidad.\nmodel EventTutorPayout {\n  id          String   @id @default(uuid())\n  eventId     String   @map(\"event_id\")\n  tutorId     String   @map(\"tutor_id\")\n  amount      Decimal  @db.Decimal(10, 2)\n  paidAt      DateTime @map(\"paid_at\")\n  note        String?\n  createdById String   @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n\n  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)\n  tutor User  @relation(\"EventTutorPayouts\", fields: [tutorId], references: [id], onDelete: Restrict)\n\n  @@index([eventId])\n  @@map(\"event_tutor_payouts\")\n}\n\nmodel StudentReview {\n  id        String           @id @default(uuid())\n  sessionId String           @map(\"session_id\")\n  tutorId   String           @map(\"tutor_id\")\n  studentId String           @map(\"student_id\")\n  rating    Int?\n  status    ReviewStatusEnum @default(pending)\n  comment   String?\n  createdAt DateTime         @default(now()) @map(\"created_at\")\n  updatedAt DateTime         @updatedAt @map(\"updated_at\")\n  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student   User             @relation(\"StudentReviewsReceived\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor     User             @relation(\"StudentReviewsWritten\", fields: [tutorId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, tutorId, studentId])\n  @@index([studentId, status])\n  @@map(\"student_reviews\")\n}\n\nmodel Payment {\n  createdAt         DateTime              @default(now()) @map(\"created_at\")\n  sessionId         String                @map(\"session_id\")\n  studentId         String                @map(\"student_id\")\n  tutorId           String                @map(\"tutor_id\")\n  // Desglose del cobro (single source of truth: src/lib/payments/fees.js):\n  //   originalAmount  = precio de lista (precio/hora × horas)\n  //   discountAmount  = descuento del cupón (0 sin cupón)\n  //   amount          = originalAmount − discountAmount → lo que Wompi cobró\n  //   tutorPayoutBase = base del 85 % del tutor: originalAmount cuando Calico\n  //                     asume el descuento, amount cuando es compartido\n  amount            Decimal               @db.Decimal(10, 2)\n  originalAmount    Decimal               @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount    Decimal               @default(0) @map(\"discount_amount\") @db.Decimal(10, 2)\n  tutorPayoutBase   Decimal               @map(\"tutor_payout_base\") @db.Decimal(10, 2)\n  couponId          String?               @map(\"coupon_id\")\n  // Único: un webhook y un confirm-payment concurrentes no pueden crear dos\n  // pagos para la misma transacción (NULL permitido para tutorías manuales).\n  wompiId           String?               @unique @map(\"wompi_id\")\n  id                String                @id @default(uuid())\n  updatedAt         DateTime?             @updatedAt @map(\"updated_at\")\n  status            PaymentStatusEnum     @default(pending)\n  tutorPayoutStatus TutorPayoutStatusEnum @default(pending) @map(\"tutor_payout_status\")\n  tutorPayoutAt     DateTime?             @map(\"tutor_payout_at\")\n  tutorPayoutNote   String?               @map(\"tutor_payout_note\")\n  tutorPayoutById   String?               @map(\"tutor_payout_by_id\")\n  // Comprobante de una tutoría manual: el estudiante paga por fuera al terminar\n  // y subir esta captura es lo que marca el pago como `paid`. Objeto privado en\n  // S3; solo admin lo ve, con una URL firmada de vida corta.\n  proofS3Key        String?               @map(\"proof_s3_key\")\n  proofUploadedAt   DateTime?             @map(\"proof_uploaded_at\")\n  session           Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student           User                  @relation(\"PaymentsStudent\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor             User                  @relation(\"PaymentsTutor\", fields: [tutorId], references: [id], onDelete: Cascade)\n  coupon            Coupon?               @relation(fields: [couponId], references: [id], onDelete: Restrict)\n  couponRedemption  CouponRedemption?\n\n  @@index([tutorPayoutStatus, status])\n  @@index([tutorId, tutorPayoutStatus])\n  @@index([couponId])\n  @@map(\"payments\")\n}\n\nmodel PaymentIntent {\n  id         String                @id @default(uuid())\n  reference  String                @unique\n  metadata   Json\n  consumedAt DateTime?             @map(\"consumed_at\")\n  kind       PaymentIntentKindEnum @default(session)\n  createdAt  DateTime              @default(now()) @map(\"created_at\")\n\n  @@map(\"payment_intents\")\n}\n\n// Cupón de descuento que el estudiante escribe antes de pagar. Reglas de\n// negocio en src/lib/services/coupon.service.js; matemática pura en\n// src/lib/payments/coupon-math.js. Borrado lógico (deletedAt) cuando ya tiene\n// redenciones, para no perder trazabilidad.\nmodel Coupon {\n  id               String                 @id @default(uuid())\n  code             String                 @unique // siempre en mayúsculas\n  description      String?\n  discountType     CouponDiscountTypeEnum @map(\"discount_type\")\n  discountValue    Decimal                @map(\"discount_value\") @db.Decimal(10, 2) // % (1-99) o COP\n  absorber         CouponAbsorberEnum     @default(CALICO)\n  maxRedemptions   Int?                   @map(\"max_redemptions\") // null = sin límite\n  perUserLimit     Int                    @default(1) @map(\"per_user_limit\")\n  firstSessionOnly Boolean                @default(false) @map(\"first_session_only\")\n  validFrom        DateTime?              @map(\"valid_from\")\n  validUntil       DateTime?              @map(\"valid_until\")\n  isActive         Boolean                @default(true) @map(\"is_active\")\n  createdById      String?                @map(\"created_by_id\")\n  createdAt        DateTime               @default(now()) @map(\"created_at\")\n  updatedAt        DateTime               @updatedAt @map(\"updated_at\")\n  deletedAt        DateTime?              @map(\"deleted_at\")\n\n  createdBy   User?              @relation(\"CouponCreator\", fields: [createdById], references: [id], onDelete: SetNull)\n  redemptions CouponRedemption[]\n  payments    Payment[]\n\n  @@index([isActive, deletedAt])\n  @@map(\"coupons\")\n}\n\n// Una fila por intento de pago que usó un cupón. Guarda el snapshot del\n// desglose para que editar el cupón después no reescriba la historia.\nmodel CouponRedemption {\n  id              String                     @id @default(uuid())\n  couponId        String                     @map(\"coupon_id\")\n  userId          String                     @map(\"user_id\")\n  intentReference String                     @unique @map(\"intent_reference\")\n  status          CouponRedemptionStatusEnum @default(RESERVED)\n  originalAmount  Decimal                    @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount  Decimal                    @map(\"discount_amount\") @db.Decimal(10, 2)\n  finalAmount     Decimal                    @map(\"final_amount\") @db.Decimal(10, 2)\n  tutorPayoutBase Decimal                    @map(\"tutor_payout_base\") @db.Decimal(10, 2)\n  absorber        CouponAbsorberEnum\n  paymentId       String?                    @unique @map(\"payment_id\")\n  sessionId       String?                    @map(\"session_id\")\n  reservedAt      DateTime                   @default(now()) @map(\"reserved_at\")\n  approvedAt      DateTime?                  @map(\"approved_at\")\n  releasedAt      DateTime?                  @map(\"released_at\")\n\n  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)\n  user    User     @relation(\"CouponRedemptions\", fields: [userId], references: [id], onDelete: Cascade)\n  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)\n  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)\n\n  @@index([couponId, status, reservedAt])\n  @@index([userId, couponId, status])\n  @@map(\"coupon_redemptions\")\n}\n\nmodel TutorApplication {\n  id              String                     @id @default(uuid())\n  userId          String                     @map(\"user_id\")\n  reasonsToTeach  String                     @map(\"reasons_to_teach\")\n  subjects        String[]\n  contactInfo     Json                       @map(\"contact_info\")\n  status          TutorApplicationStatusEnum @default(Pending)\n  createdAt       DateTime                   @default(now()) @map(\"created_at\")\n  updatedAt       DateTime                   @updatedAt @map(\"updated_at\")\n  rejectionReason String?                    @map(\"rejection_reason\")\n  reviewedAt      DateTime?                  @map(\"reviewed_at\")\n  reviewedById    String?                    @map(\"reviewed_by_id\")\n  reviewedBy      User?                      @relation(\"ApplicationReviewedBy\", fields: [reviewedById], references: [id])\n  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"tutor_applications\")\n}\n\nmodel Notification {\n  id        String   @id @default(uuid())\n  userId    String   @map(\"user_id\")\n  type      String\n  message   String\n  isRead    Boolean  @default(false) @map(\"is_read\")\n  sessionId String?  @map(\"session_id\")\n  metadata  Json?\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n  session   Session? @relation(fields: [sessionId], references: [id])\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, isRead])\n  @@index([userId, createdAt(sort: Desc)])\n  @@map(\"notifications\")\n}\n\n// Noticias/anuncios publicados por admins y mostrados en la landing y en los\n// homes de estudiante y tutor. `content` es Markdown crudo (un solo idioma);\n// se renderiza en el cliente sin HTML embebido. `imageUrl` apunta a S3\n// (prefijo news-images/), URL pública persistida igual que profilePictureUrl.\nmodel NewsPost {\n  id          String    @id @default(uuid())\n  title       String\n  content     String\n  imageUrl    String?   @map(\"image_url\")\n  isPublished Boolean   @default(false) @map(\"is_published\")\n  isPinned    Boolean   @default(false) @map(\"is_pinned\")\n  publishedAt DateTime? @map(\"published_at\")\n  authorId    String    @map(\"author_id\")\n  createdAt   DateTime  @default(now()) @map(\"created_at\")\n  updatedAt   DateTime  @updatedAt @map(\"updated_at\")\n  author      User      @relation(\"NewsAuthor\", fields: [authorId], references: [id])\n\n  @@index([isPublished, isPinned, publishedAt(sort: Desc)])\n  @@map(\"news_posts\")\n}\n\nmodel AdminAuditLog {\n  id         String   @id @default(uuid())\n  adminId    String   @map(\"admin_id\")\n  action     String\n  targetType String?  @map(\"target_type\")\n  targetId   String?  @map(\"target_id\")\n  payload    Json?\n  ipAddress  String?  @map(\"ip_address\")\n  userAgent  String?  @map(\"user_agent\")\n  createdAt  DateTime @default(now()) @map(\"created_at\")\n  admin      User     @relation(\"AdminActor\", fields: [adminId], references: [id])\n\n  @@index([adminId, createdAt(sort: Desc)])\n  @@index([action, createdAt(sort: Desc)])\n  @@index([targetType, targetId])\n  @@map(\"admin_audit_log\")\n}\n\n// Piezas de marketing (posts de Instagram y presentaciones) que se crean con la\n// herramienta local content-creator. Aquí vive la fuente compartida de cada\n// pieza: brief e historial (`meta`), caption y la lista de archivos fuente\n// (`files`: index.html, img/*), que están en S3 bajo marketing-pieces/{slug}/src/.\n// Lo publicado (PNG/PDF + manifest.json) sigue en marketing-posts/{slug}/.\n// `version` sube en cada guardado: el cliente manda la versión que leyó y si no\n// coincide recibe 409 (otra persona guardó antes).\nmodel MarketingPiece {\n  id                     String    @id @default(uuid())\n  slug                   String    @unique\n  title                  String\n  type                   String\n  style                  String?\n  caption                String    @default(\"\")\n  meta                   Json      @default(\"{}\")\n  files                  Json      @default(\"[]\")\n  version                Int       @default(1)\n  createdById            String    @map(\"created_by_id\")\n  updatedById            String    @map(\"updated_by_id\")\n  publishedById          String?   @map(\"published_by_id\")\n  publishedAt            DateTime? @map(\"published_at\")\n  // Agenda (la pone una persona; subir a Instagram es a mano). Se deriva del\n  // `meta` que manda content-creator (planId, fechaPublicacion, publicadaInstagramEn)\n  // y Admin → Posts la puede cambiar. `planEntryKey` es el `key` de la entrada del\n  // plan de la que salió la pieza (enlace suave: borrar la entrada no borra la pieza).\n  planEntryKey           String?   @map(\"plan_entry_key\")\n  plannedFor             DateTime? @map(\"planned_for\") @db.Date\n  instagramPublishedAt   DateTime? @map(\"instagram_published_at\") @db.Date\n  instagramPublishedById String?   @map(\"instagram_published_by_id\")\n  createdAt              DateTime  @default(now()) @map(\"created_at\")\n  updatedAt              DateTime  @updatedAt @map(\"updated_at\")\n  createdBy              User      @relation(\"MarketingPieceCreator\", fields: [createdById], references: [id])\n  updatedBy              User      @relation(\"MarketingPieceUpdater\", fields: [updatedById], references: [id])\n  publishedBy            User?     @relation(\"MarketingPiecePublisher\", fields: [publishedById], references: [id])\n  instagramPublishedBy   User?     @relation(\"MarketingPieceInstagramPublisher\", fields: [instagramPublishedById], references: [id])\n\n  @@index([updatedAt(sort: Desc)])\n  @@index([planEntryKey])\n  @@index([plannedFor])\n  @@map(\"marketing_pieces\")\n}\n\n// Plan de contenido de Instagram (content-creator): una guía de qué publicar\n// cada día de una temporada. `settings` guarda lo que el estudio necesita para\n// dibujarlo (semanas del semestre, fases, festivos, nota). `version` funciona\n// igual que en las piezas: 409 si otra persona guardó antes.\nmodel MarketingPlan {\n  id          String               @id @default(uuid())\n  key         String               @unique // p. ej. \"2026-2\"\n  title       String\n  startsOn    DateTime             @map(\"starts_on\") @db.Date\n  endsOn      DateTime             @map(\"ends_on\") @db.Date\n  settings    Json                 @default(\"{}\")\n  version     Int                  @default(1)\n  createdById String               @map(\"created_by_id\")\n  updatedById String               @map(\"updated_by_id\")\n  createdAt   DateTime             @default(now()) @map(\"created_at\")\n  updatedAt   DateTime             @updatedAt @map(\"updated_at\")\n  createdBy   User                 @relation(\"MarketingPlanCreator\", fields: [createdById], references: [id])\n  updatedBy   User                 @relation(\"MarketingPlanUpdater\", fields: [updatedById], references: [id])\n  entries     MarketingPlanEntry[]\n\n  @@index([endsOn])\n  @@map(\"marketing_plans\")\n}\n\n// Una fila por entrada del plan, para moverla, editarla o saltarla sin tocar\n// las demás. `key` es el slug que tendrá la pieza que nazca de ella (por eso es\n// único en toda la tabla). `brief` es lo que llega al formulario del estudio;\n// `details` el resto (idea, gancho, estilo, material que necesita, preguntas de\n// una grabación…). `skipped` = el equipo decidió no hacerla.\nmodel MarketingPlanEntry {\n  id          String        @id @default(uuid())\n  planId      String        @map(\"plan_id\")\n  key         String        @unique\n  date        DateTime      @db.Date\n  format      String\n  title       String\n  brief       Json?\n  details     Json          @default(\"{}\")\n  skipped     Boolean       @default(false)\n  version     Int           @default(1)\n  createdById String        @map(\"created_by_id\")\n  updatedById String        @map(\"updated_by_id\")\n  createdAt   DateTime      @default(now()) @map(\"created_at\")\n  updatedAt   DateTime      @updatedAt @map(\"updated_at\")\n  plan        MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\n  createdBy   User          @relation(\"MarketingPlanEntryCreator\", fields: [createdById], references: [id])\n  updatedBy   User          @relation(\"MarketingPlanEntryUpdater\", fields: [updatedById], references: [id])\n\n  @@index([planId, date])\n  @@map(\"marketing_plan_entries\")\n}\n\n// Tokens personales para que content-creator use /api/content-creator/*.\n// Solo se guarda el SHA-256 del token; el token en claro se muestra una vez al\n// crearlo (prisma/create-content-token.mjs). Cada token pertenece a un admin:\n// si el usuario deja de ser ADMIN o se desactiva, el token deja de servir.\nmodel ContentCreatorToken {\n  id         String    @id @default(uuid())\n  userId     String    @map(\"user_id\")\n  label      String\n  tokenHash  String    @unique @map(\"token_hash\")\n  lastUsedAt DateTime? @map(\"last_used_at\")\n  revokedAt  DateTime? @map(\"revoked_at\")\n  createdAt  DateTime  @default(now()) @map(\"created_at\")\n  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@map(\"content_creator_tokens\")\n}\n"
+  "inlineSchema": "generator client {\n  provider = \"prisma-client-js\"\n  output   = \"../src/generated/prisma\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n}\n\n// ─── ENUMS ────────────────────────────────────────────────────────────\n\nenum ComplexityEnum {\n  Introductory\n  Foundational\n  Challenging\n}\n\nenum SessionTypeEnum {\n  Individual\n  Group\n}\n\nenum SessionStatusEnum {\n  Pending\n  Accepted\n  Rejected\n  Completed\n  Canceled\n}\n\nenum LocationTypeEnum {\n  Virtual\n  Custom\n}\n\nenum TutorApplicationStatusEnum {\n  Pending\n  Approved\n  Rejected\n}\n\nenum PaymentStatusEnum {\n  pending\n  paid\n  failed\n}\n\nenum TutorPayoutStatusEnum {\n  pending\n  paid\n}\n\n// ─── CUPONES ──────────────────────────────────────────────────────────\n// Tipo de descuento: porcentaje sobre el precio de lista o monto fijo en COP.\nenum CouponDiscountTypeEnum {\n  PERCENT\n  FIXED\n}\n\n// Quién asume el descuento:\n//   CALICO → el tutor recibe su 85 % del precio de lista; el descuento sale\n//            de la comisión de Calico.\n//   SHARED → el tutor acordó participar: recibe su 85 % del monto cobrado.\nenum CouponAbsorberEnum {\n  CALICO\n  SHARED\n}\n\n// Ciclo de vida de una redención: se RESERVA al crear el intento de pago,\n// pasa a APPROVED cuando Wompi aprueba y se RELEASED si el pago falla.\n// Una reserva sin pago deja de contar sola pasados 30 minutos.\nenum CouponRedemptionStatusEnum {\n  RESERVED\n  APPROVED\n  RELEASED\n}\n\nenum ReviewStatusEnum {\n  pending\n  done\n}\n\nenum TutorCourseStatusEnum {\n  Pending\n  Approved\n  Rejected\n  // The tutor stopped offering an approved course and can resume it without an admin.\n  Paused\n}\n\nenum CourseSuggestionStatusEnum {\n  Pending\n  Approved\n  Rejected\n}\n\n// ─── CAREERS ──────────────────────────────────────────────────────────\n\nmodel Career {\n  id      String   @id @default(uuid())\n  code    String   @unique\n  name    String\n  users   User[]\n  courses Course[]\n\n  @@map(\"careers\")\n}\n\n// ─── AUTH PROVIDER ENUM ───────────────────────────────────────────────\n\nenum AuthProviderEnum {\n  Local\n  Google\n}\n\nenum UserKind {\n  Registered\n  ExternalTemporary\n}\n\nenum SessionSourceEnum {\n  Platform\n  ManualAdmin\n}\n\n// ─── USER ROLE ────────────────────────────────────────────────────────\n// Base role of the user. Orthogonal to `isTutorApproved` — an admin can\n// also be an approved tutor if needed. New roles (MODERATOR, SUPPORT…)\n// can be added without schema changes elsewhere.\nenum Role {\n  STUDENT\n  ADMIN\n}\n\n// ─── USERS ────────────────────────────────────────────────────────────\n\n// ─── EVENTOS (repasos grupales) ───────────────────────────────────────\nenum EventStatusEnum {\n  Draft\n  Published\n  Canceled\n}\n\nenum EventModalityEnum {\n  Virtual\n  InPerson\n}\n\n// PendingApproval / Rejected: only on events with requiresApproval (payment\n// coordinated outside the platform; an admin approves or rejects each row).\nenum EventRegistrationStatusEnum {\n  PendingPayment\n  PendingApproval\n  Confirmed\n  Rejected\n  Canceled\n}\n\nenum EventPaymentFlagEnum {\n  DUPLICATE\n  EVENT_CANCELED\n  REGISTRATION_CANCELED\n  EARLY_BIRD_OVERRUN\n}\n\nenum EventRefundStatusEnum {\n  None\n  Pending\n  Refunded\n}\n\nenum PaymentIntentKindEnum {\n  session\n  event\n}\n\nmodel User {\n  id                    String  @id @default(uuid())\n  email                 String  @unique\n  passwordHash          String? @map(\"password_hash\")\n  name                  String\n  phoneNumber           String? @map(\"phone_number\")\n  phoneNumberNormalized String? @unique @map(\"phone_number_normalized\")\n  // Usuario de WhatsApp sin la @, escrito por un admin en una tutoría manual.\n  // Dato interno de contacto: no es único ni identifica a nadie, y\n  // user.repository lo quita de las lecturas genéricas.\n  whatsappTag           String? @map(\"whatsapp_tag\")\n  profilePictureUrl     String? @map(\"profile_picture_url\")\n  careerId              String? @map(\"career_id\")\n\n  // OAuth fields\n  authProvider AuthProviderEnum @default(Local) @map(\"auth_provider\")\n  googleId     String?          @unique @map(\"google_id\")\n\n  // Roles y estado\n  role             Role     @default(STUDENT)\n  kind             UserKind @default(Registered)\n  isTutorRequested Boolean  @default(false) @map(\"is_tutor_requested\")\n  isTutorApproved  Boolean  @default(false) @map(\"is_tutor_approved\")\n  isActive         Boolean  @default(true) @map(\"is_active\")\n  isEmailVerified  Boolean  @default(false) @map(\"is_email_verified\")\n\n  // Incremented on password change/reset to invalidate previously-issued JWTs.\n  // Column already exists in the DB (migration 20260613000000) but was never\n  // declared here, so Prisma silently dropped every read/write of it.\n  tokenVersion Int @default(0) @map(\"token_version\")\n\n  // Moderación (suspensión por mala conducta o ratings bajos)\n  suspendedAt     DateTime? @map(\"suspended_at\")\n  suspendedReason String?   @map(\"suspended_reason\")\n  suspendedById   String?   @map(\"suspended_by_id\")\n\n  // Terms and conditions\n  terms            Boolean   @default(false)\n  marketingOptInAt DateTime? @map(\"marketing_opt_in_at\")\n\n  // Tokens de verificación y reset\n  verificationToken       String?   @map(\"verification_token\")\n  verificationTokenExpiry DateTime? @map(\"verification_token_expiry\")\n  resetToken              String?   @map(\"reset_token\")\n  resetTokenExpiry        DateTime? @map(\"reset_token_expiry\")\n  otpCode                 String?   @map(\"otp_code\")\n  otpCodeExpiry           DateTime? @map(\"otp_code_expiry\")\n  // Failed OTP verification attempts for the current code. Reset to 0 when a\n  // fresh OTP is issued; once it hits the cap the code is invalidated to stop\n  // brute-forcing the 6-digit OTP (server-side, survives across instances).\n  otpAttempts             Int       @default(0) @map(\"otp_attempts\")\n\n  // Última vez que el usuario estuvo en la app (\"last seen\"). Se usa para\n  // métricas de engagement (usuarios activos en la última semana). Como la\n  // sesión JWT persiste, NO basta con el login: se refresca también en el\n  // heartbeat /api/auth/me (con throttle). Best-effort / fire-and-forget.\n  lastSeenAt DateTime? @map(\"last_seen_at\")\n\n  // Calificación como ESTUDIANTE (tutores → estudiante, estilo Uber).\n  // Agregado denormalizado de student_reviews con status 'done' — mismo\n  // patrón que TutorProfile.review/numReview. PRIVADA: visible solo para\n  // tutores con una sesión vinculada a este estudiante, para admins y para\n  // el propio estudiante (solo el número, nunca los comentarios).\n  studentRating      Decimal @default(0) @map(\"student_rating\") @db.Decimal(3, 2)\n  studentRatingCount Int     @default(0) @map(\"student_rating_count\")\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  // Relaciones\n  career                    Career?                    @relation(fields: [careerId], references: [id])\n  tutorProfile              TutorProfile?\n  schedule                  Schedule?                  @relation(\"UserSchedule\")\n  googleCalendarCredential  GoogleCalendarCredential?\n  availabilities            Availability[]\n  tutorSessions             Session[]                  @relation(\"TutorSessions\")\n  participations            SessionParticipant[]\n  reviewsWritten            Review[]                   @relation(\"ReviewsWritten\")\n  eventsCreated             Event[]                    @relation(\"EventCreator\")\n  eventTutoring             EventTutor[]               @relation(\"EventTutoring\")\n  eventRegistrations        EventRegistration[]        @relation(\"EventRegistrations\")\n  eventTutorPayouts         EventTutorPayout[]         @relation(\"EventTutorPayouts\")\n  reviewsReceived           Review[]                   @relation(\"ReviewsReceived\")\n  studentReviewsWritten     StudentReview[]            @relation(\"StudentReviewsWritten\")\n  studentReviewsReceived    StudentReview[]            @relation(\"StudentReviewsReceived\")\n  paymentsAsStudent         Payment[]                  @relation(\"PaymentsStudent\")\n  paymentsAsTutor           Payment[]                  @relation(\"PaymentsTutor\")\n  tutorApplications         TutorApplication[]\n  notifications             Notification[]\n  courseNotifySubscriptions CourseNotifySubscription[]\n\n  // Moderación: quién suspendió a este usuario (self-relation)\n  suspendedBy    User?  @relation(\"UserSuspendedBy\", fields: [suspendedById], references: [id])\n  suspendedUsers User[] @relation(\"UserSuspendedBy\")\n\n  // Aplicaciones de tutor revisadas por este admin\n  applicationsReviewed TutorApplication[] @relation(\"ApplicationReviewedBy\")\n\n  // Acciones admin ejecutadas por este usuario\n  adminActions                AdminAuditLog[]       @relation(\"AdminActor\")\n  manualSessionsCreated       Session[]             @relation(\"ManualSessionCreator\")\n  courseSuggestionsRequested  CourseSuggestion[]    @relation(\"CourseSuggestionRequester\")\n  courseSuggestionsReviewed   CourseSuggestion[]    @relation(\"CourseSuggestionReviewer\")\n  newsPosts                   NewsPost[]            @relation(\"NewsAuthor\")\n  couponsCreated              Coupon[]              @relation(\"CouponCreator\")\n  couponRedemptions           CouponRedemption[]    @relation(\"CouponRedemptions\")\n  marketingPiecesCreated      MarketingPiece[]      @relation(\"MarketingPieceCreator\")\n  marketingPiecesUpdated      MarketingPiece[]      @relation(\"MarketingPieceUpdater\")\n  marketingPiecesPublished    MarketingPiece[]      @relation(\"MarketingPiecePublisher\")\n  marketingPiecesOnInstagram  MarketingPiece[]      @relation(\"MarketingPieceInstagramPublisher\")\n  marketingPlansCreated       MarketingPlan[]       @relation(\"MarketingPlanCreator\")\n  marketingPlansUpdated       MarketingPlan[]       @relation(\"MarketingPlanUpdater\")\n  marketingPlanEntriesCreated MarketingPlanEntry[]  @relation(\"MarketingPlanEntryCreator\")\n  marketingPlanEntriesUpdated MarketingPlanEntry[]  @relation(\"MarketingPlanEntryUpdater\")\n  contentCreatorTokens        ContentCreatorToken[]\n\n  @@map(\"users\")\n}\n\nmodel TutorProfile {\n  userId                String        @id @map(\"user_id\")\n  schoolEmail           String        @unique @map(\"school_email\")\n  experienceYears       Int?          @map(\"experience_years\")\n  credits               Int           @default(0)\n  experienceDescription String?       @map(\"experience_description\")\n  updatedAt             DateTime      @updatedAt @map(\"updated_at\")\n  review                Decimal       @default(0) @db.Decimal(3, 2)\n  numReview             Int           @default(0) @map(\"num_review\")\n  numSessions           Int           @default(0) @map(\"num_sessions\")\n  nextPayment           Decimal       @default(0) @map(\"next_payment\") @db.Decimal(12, 2)\n  totalEarning          Decimal       @default(0) @map(\"total_earning\") @db.Decimal(12, 2)\n  // 2000 = TUTOR_BIO_MAX_LENGTH en src/config/profile.js y el max() de Zod en\n  // /api/tutor/profile. Los tres tienen que moverse juntos.\n  bio                   String?       @map(\"bio\") @db.VarChar(2000)\n  llave                 String?\n  tutorCourses          TutorCourse[]\n  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"tutor_profiles\")\n}\n\nmodel Course {\n  id                  String                     @id @default(uuid())\n  name                String\n  code                String                     @unique\n  basePrice           Decimal                    @map(\"base_price\") @db.Decimal(10, 2)\n  complexity          ComplexityEnum\n  aliases             String[]                   @default([])\n  careerId            String                     @map(\"career_id\")\n  career              Career                     @relation(fields: [careerId], references: [id])\n  reviews             Review[]\n  events              Event[]\n  sessions            Session[]\n  tutorCourses        TutorCourse[]\n  suggestions         CourseSuggestion[]\n  notifySubscriptions CourseNotifySubscription[]\n\n  @@index([careerId])\n  @@map(\"courses\")\n}\n\nmodel CourseNotifySubscription {\n  id                String    @id @default(uuid())\n  studentId         String    @map(\"student_id\")\n  courseId          String    @map(\"course_id\")\n  notificationEmail String    @map(\"notification_email\")\n  source            String    @default(\"unknown\")\n  notifiedAt        DateTime? @map(\"notified_at\")\n  cancelledAt       DateTime? @map(\"cancelled_at\")\n  createdAt         DateTime  @default(now()) @map(\"created_at\")\n  updatedAt         DateTime  @updatedAt @map(\"updated_at\")\n\n  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)\n  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)\n\n  @@index([courseId, notifiedAt, cancelledAt])\n  @@index([studentId, courseId])\n  @@map(\"course_notify_subscriptions\")\n}\n\nmodel CourseSuggestion {\n  id           String                     @id @default(uuid())\n  code         String\n  name         String\n  notes        String?\n  status       CourseSuggestionStatusEnum @default(Pending)\n  requesterId  String?                    @map(\"requester_id\")\n  reviewedById String?                    @map(\"reviewed_by_id\")\n  reviewedAt   DateTime?                  @map(\"reviewed_at\")\n  courseId     String?                    @map(\"course_id\")\n  createdAt    DateTime                   @default(now()) @map(\"created_at\")\n  updatedAt    DateTime                   @updatedAt @map(\"updated_at\")\n\n  requester  User?   @relation(\"CourseSuggestionRequester\", fields: [requesterId], references: [id], onDelete: SetNull)\n  reviewedBy User?   @relation(\"CourseSuggestionReviewer\", fields: [reviewedById], references: [id], onDelete: SetNull)\n  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)\n\n  @@index([status, createdAt])\n  @@index([code])\n  @@map(\"course_suggestions\")\n}\n\nmodel TutorCourse {\n  tutorId       String                @map(\"tutor_id\")\n  courseId      String                @map(\"course_id\")\n  experience    String?               @map(\"experience\")\n  workSampleUrl String?               @map(\"work_sample_url\")\n  status        TutorCourseStatusEnum @default(Pending)\n  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  tutor         TutorProfile          @relation(fields: [tutorId], references: [userId], onDelete: Cascade)\n\n  @@id([tutorId, courseId])\n  @@map(\"tutor_courses\")\n}\n\nmodel Schedule {\n  id                String  @id @default(uuid())\n  userId            String  @unique @map(\"user_id\")\n  timezone          String  @default(\"America/Bogota\")\n  autoAcceptSession Boolean @default(false) @map(\"auto_accept_session\")\n  minBookingNotice  Int     @default(24) @map(\"min_booking_notice\")\n  maxSessionsPerDay Int     @default(5) @map(\"max_sessions_per_day\")\n  bufferTime        Int     @default(15) @map(\"buffer_time\")\n  calendarSyncId    String? @map(\"calendar_sync_id\")\n  calendarSyncMode  String? @default(\"available\") @map(\"calendar_sync_mode\")\n\n  // Estado de la integración con Google Calendar. Los tokens OAuth viven solo\n  // en cookies HttpOnly del navegador del tutor, así que el servidor (y el\n  // panel admin) no puede saber si sigue conectado: estas columnas son la\n  // única señal persistida. `calendarConnectedAt` se escribe al elegir\n  // calendario y se limpia al desconectar; las otras dos, en cada sync.\n  calendarConnectedAt  DateTime? @map(\"calendar_connected_at\")\n  calendarLastSyncedAt DateTime? @map(\"calendar_last_synced_at\")\n  calendarLastSyncOk   Boolean?  @map(\"calendar_last_sync_ok\")\n\n  user User @relation(\"UserSchedule\", fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"schedules\")\n}\n\n// Credenciales OAuth de Google Calendar del tutor, persistidas para que la\n// conexión sobreviva al navegador (antes: cookies HttpOnly de 30 días en un\n// solo dispositivo). Los tokens van cifrados con AES-256-GCM\n// (src/lib/security/secret-box.js) y NUNCA salen del repositorio en claro:\n// `google-calendar-credential.repository` solo expone `toSummary()` hacia\n// fuera; el descifrado ocurre dentro de `calendar-credential.service`.\n// Desconectar borra la fila. `revokedAt` marca que Google rechazó el refresh\n// token (invalid_grant): la fila se conserva para que la UI explique por qué\n// hay que reconectar, y la siguiente conexión la reemplaza.\nmodel GoogleCalendarCredential {\n  userId                String    @id @map(\"user_id\")\n  refreshTokenEncrypted String    @map(\"refresh_token_encrypted\")\n  accessTokenEncrypted  String?   @map(\"access_token_encrypted\")\n  accessTokenExpiresAt  DateTime? @map(\"access_token_expires_at\")\n  scope                 String?\n  revokedAt             DateTime? @map(\"revoked_at\")\n  revokedReason         String?   @map(\"revoked_reason\")\n  createdAt             DateTime  @default(now()) @map(\"created_at\")\n  updatedAt             DateTime  @updatedAt @map(\"updated_at\")\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"google_calendar_credentials\")\n}\n\nmodel Availability {\n  id           String    @id @default(uuid())\n  dayOfWeek    Int       @map(\"day_of_week\")\n  endTime      DateTime  @map(\"end_time\") @db.Time(6)\n  startTime    DateTime  @map(\"start_time\") @db.Time(6)\n  userId       String    @map(\"user_id\")\n  label        String?   @map(\"label\") @db.VarChar(160)\n  recurring    Boolean   @default(true) @map(\"recurring\")\n  specificDate DateTime? @map(\"specific_date\") @db.Date\n  source       String    @default(\"manual\") @map(\"source\")\n  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"availabilities\")\n}\n\nmodel Session {\n  id                String            @id @default(uuid())\n  courseId          String            @map(\"course_id\")\n  tutorId           String            @map(\"tutor_id\")\n  sessionType       SessionTypeEnum   @map(\"session_type\")\n  maxCapacity       Int               @default(1) @map(\"max_capacity\")\n  startTimestamp    DateTime          @map(\"start_timestamp\")\n  endTimestamp      DateTime          @map(\"end_timestamp\")\n  status            SessionStatusEnum @default(Pending)\n  locationType      LocationTypeEnum  @map(\"location_type\")\n  notes             String?\n  topicsToReview    String?           @map(\"topics_to_review\")\n  source            SessionSourceEnum @default(Platform)\n  manualCreatedById String?           @map(\"manual_created_by_id\")\n  createdAt         DateTime          @default(now()) @map(\"created_at\")\n\n  // Google Calendar integration\n  googleCalendarEventId String? @map(\"google_calendar_event_id\")\n  googleMeetLink        String? @map(\"google_meet_link\")\n\n  // Cancellation tracking\n  cancellationReason  String?   @map(\"cancellation_reason\")\n  cancelledAt         DateTime? @map(\"cancelled_at\")\n  cancelledBy         String?   @map(\"cancelled_by\")\n  refundMethod        String?   @map(\"refund_method\") // 'bank_transfer', 'nequi', 'use_future_session', etc.\n  refundMethodDetails String?   @map(\"refund_method_details\") // Additional info (bank account, etc.)\n\n  course            Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)\n  tutor             User                 @relation(\"TutorSessions\", fields: [tutorId], references: [id], onDelete: Restrict)\n  manualCreatedBy   User?                @relation(\"ManualSessionCreator\", fields: [manualCreatedById], references: [id], onDelete: SetNull)\n  participants      SessionParticipant[]\n  payments          Payment[]\n  reviews           Review[]\n  studentReviews    StudentReview[]\n  notifications     Notification[]\n  attachments       SessionAttachment[]\n  materials         SessionMaterial[]\n  couponRedemptions CouponRedemption[]\n\n  @@index([tutorId, status, startTimestamp(sort: Desc)])\n  @@map(\"sessions\")\n}\n\nmodel SessionAttachment {\n  id         String   @id @default(uuid())\n  sessionId  String   @map(\"session_id\")\n  s3Key      String   @map(\"s3_key\")\n  fileName   String   @map(\"file_name\")\n  fileSize   Int      @map(\"file_size\")\n  mimeType   String   @map(\"mime_type\")\n  uploadedAt DateTime @default(now()) @map(\"uploaded_at\")\n  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n\n  @@index([sessionId])\n  @@map(\"session_attachments\")\n}\n\n// Material de estudio de una tutoría: lo suben el tutor o un admin para el\n// estudiante, al revés que SessionAttachment (del estudiante para el tutor). El\n// estudiante solo lo descarga tras dejar su reseña con comentario. Archivos en un\n// prefijo privado de S3; las reglas están en session-material.service.js.\nmodel SessionMaterial {\n  id          String   @id @default(uuid())\n  sessionId   String   @map(\"session_id\")\n  s3Key       String   @map(\"s3_key\")\n  fileName    String   @map(\"file_name\")\n  mimeType    String   @map(\"mime_type\")\n  fileSize    Int      @map(\"file_size\")\n  createdById String?  @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, s3Key])\n  @@index([sessionId, createdAt])\n  @@map(\"session_materials\")\n}\n\nmodel SessionParticipant {\n  sessionId        String   @map(\"session_id\")\n  studentId        String   @map(\"student_id\")\n  joinedAt         DateTime @default(now()) @map(\"joined_at\")\n  participantCount Int      @default(1) @map(\"participant_count\")\n  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)\n\n  @@id([sessionId, studentId])\n  @@index([studentId, sessionId])\n  @@map(\"session_participants\")\n}\n\nmodel Review {\n  id          String           @id @default(uuid())\n  rating      Int?\n  tutorId     String           @map(\"tutor_id\")\n  studentId   String           @map(\"student_id\")\n  // Arco exclusivo: una reseña es de una sesión O de un evento\n  // (CHECK reviews_session_xor_event en prisma/sql/).\n  sessionId   String?          @map(\"session_id\")\n  eventId     String?          @map(\"event_id\")\n  comment     String?\n  status      ReviewStatusEnum @default(pending)\n  // When the student rated. Not a created_at: a session's row is an empty\n  // placeholder long before that. Set once; editing a review does not move it.\n  submittedAt DateTime?        @map(\"submitted_at\")\n  courseId    String?          @map(\"course_id\")\n  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Restrict)\n  session     Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)\n  student     User             @relation(\"ReviewsWritten\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor       User             @relation(\"ReviewsReceived\", fields: [tutorId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, studentId, tutorId])\n  @@unique([eventId, studentId, tutorId])\n  @@index([tutorId, courseId, status])\n  @@index([eventId])\n  @@map(\"reviews\")\n}\n\n// Evento grupal (repaso). Precio fijo en COP (0 = gratis). \"Finalizado\" se\n// deriva de endsAt < now. Ver docs/superpowers/specs/2026-10-03-eventos-design.md\nmodel Event {\n  id                    String            @id @default(uuid())\n  slug                  String            @unique\n  title                 String\n  description           String\n  coverImageUrl         String?           @map(\"cover_image_url\")\n  courseId              String?           @map(\"course_id\")\n  startsAt              DateTime          @map(\"starts_at\")\n  endsAt                DateTime          @map(\"ends_at\")\n  // Hora por confirmar: startsAt/endsAt solo guardan el día (00:00–23:59\n  // Bogotá) y durationHours cuánto durará. El admin fija la hora después.\n  timeTbc               Boolean           @default(false) @map(\"time_tbc\")\n  durationHours         Float?            @map(\"duration_hours\")\n  modality              EventModalityEnum\n  autoMeet              Boolean           @default(false) @map(\"auto_meet\")\n  meetingUrl            String?           @map(\"meeting_url\")\n  // Grupo de WhatsApp en vez de Meet; solo lo ven los inscritos Confirmed.\n  whatsappUrl           String?           @map(\"whatsapp_url\")\n  location              String?\n  googleCalendarEventId String?           @map(\"google_calendar_event_id\")\n  price                 Decimal           @db.Decimal(10, 2)\n  earlyBirdSlots        Int?              @map(\"early_bird_slots\")\n  earlyBirdPercent      Int?              @map(\"early_bird_percent\")\n  // Mínimo por tutor (COP): los tutores reciben máx(n × mínimo, 40 % del recaudo\n  // neto de Wompi). null = 60 000/h × horas (src/lib/payments/event-earnings.js).\n  tutorMinPayout        Decimal?          @map(\"tutor_min_payout\") @db.Decimal(10, 2)\n  isListed              Boolean           @default(true) @map(\"is_listed\")\n  // Registrations wait for an admin (PendingApproval) instead of being\n  // confirmed or paid through Wompi; `price` is then only informative.\n  requiresApproval      Boolean           @default(false) @map(\"requires_approval\")\n  // Private code of the post-event attendance link (/eventos/{slug}?asistencia=CODE),\n  // for a free event that took place without prior sign-ups. null = link closed.\n  attendanceCode        String?           @map(\"attendance_code\")\n  status                EventStatusEnum   @default(Draft)\n  publishedAt           DateTime?         @map(\"published_at\")\n  canceledAt            DateTime?         @map(\"canceled_at\")\n  cancelReason          String?           @map(\"cancel_reason\")\n  lastReminderAt        DateTime?         @map(\"last_reminder_at\")\n  createdById           String?           @map(\"created_by_id\")\n  createdAt             DateTime          @default(now()) @map(\"created_at\")\n  updatedAt             DateTime          @updatedAt @map(\"updated_at\")\n\n  course        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)\n  createdBy     User?               @relation(\"EventCreator\", fields: [createdById], references: [id], onDelete: SetNull)\n  tutors        EventTutor[]\n  registrations EventRegistration[]\n  tutorPayouts  EventTutorPayout[]\n  reviews       Review[]\n  materials     EventMaterial[]\n\n  @@index([status, isListed, startsAt])\n  @@map(\"events\")\n}\n\nmodel EventTutor {\n  eventId  String @map(\"event_id\")\n  tutorId  String @map(\"tutor_id\")\n  position Int    @default(0)\n\n  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)\n  tutor User  @relation(\"EventTutoring\", fields: [tutorId], references: [id], onDelete: Restrict)\n\n  @@id([eventId, tutorId])\n  @@index([tutorId])\n  @@map(\"event_tutors\")\n}\n\n// Una fila por (evento, usuario). PendingPayment = checkout abierto con una\n// reserva de 30 min (reservedAt); PendingApproval = espera a un admin\n// (eventos con requiresApproval); Confirmed = inscrito; Rejected = un admin\n// la rechazó; Canceled = cancelado.\nmodel EventRegistration {\n  id                  String                      @id @default(uuid())\n  eventId             String                      @map(\"event_id\")\n  userId              String                      @map(\"user_id\")\n  status              EventRegistrationStatusEnum\n  earlyBird           Boolean                     @default(false) @map(\"early_bird\")\n  reservedAt          DateTime?                   @map(\"reserved_at\")\n  listPrice           Decimal                     @map(\"list_price\") @db.Decimal(10, 2)\n  discountAmount      Decimal                     @default(0) @map(\"discount_amount\") @db.Decimal(10, 2)\n  finalAmount         Decimal                     @map(\"final_amount\") @db.Decimal(10, 2)\n  intentReference     String?                     @unique @map(\"intent_reference\")\n  source              String?\n  confirmedAt         DateTime?                   @map(\"confirmed_at\")\n  canceledAt          DateTime?                   @map(\"canceled_at\")\n  canceledBy          String?                     @map(\"canceled_by\")\n  refundMethod        String?                     @map(\"refund_method\")\n  refundMethodDetails String?                     @map(\"refund_method_details\")\n  surveyRemindedAt    DateTime?                   @map(\"survey_reminded_at\")\n  reviewedAt          DateTime?                   @map(\"reviewed_at\")\n  reviewedById        String?                     @map(\"reviewed_by_id\")\n  createdAt           DateTime                    @default(now()) @map(\"created_at\")\n  updatedAt           DateTime                    @updatedAt @map(\"updated_at\")\n\n  event          Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)\n  user           User                 @relation(\"EventRegistrations\", fields: [userId], references: [id], onDelete: Cascade)\n  payments       EventPayment[]\n  surveyResponse EventSurveyResponse?\n\n  @@unique([eventId, userId])\n  @@index([eventId, status, earlyBird])\n  @@index([userId, status])\n  @@map(\"event_registrations\")\n}\n\n// Cada transacción aprobada de Wompi para un evento. wompiId único = barrera\n// de idempotencia. flag != null → anomalía visible en admin.\nmodel EventPayment {\n  id               String                @id @default(uuid())\n  registrationId   String                @map(\"registration_id\")\n  wompiId          String                @unique @map(\"wompi_id\")\n  reference        String\n  amount           Decimal               @db.Decimal(10, 2)\n  originalAmount   Decimal               @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount   Decimal               @map(\"discount_amount\") @db.Decimal(10, 2)\n  flag             EventPaymentFlagEnum?\n  refundStatus     EventRefundStatusEnum @default(None) @map(\"refund_status\")\n  refundedAt       DateTime?             @map(\"refunded_at\")\n  refundedById     String?               @map(\"refunded_by_id\")\n  // Devolución parcial (null = total) y desde qué cuenta salió, con comprobante.\n  refundAmount     Decimal?              @map(\"refund_amount\") @db.Decimal(10, 2)\n  refundAccountId  String?               @map(\"refund_account_id\")\n  refundProofS3Key String?               @map(\"refund_proof_s3_key\")\n  createdAt        DateTime              @default(now()) @map(\"created_at\")\n\n  refundAccount FinanceAccount?   @relation(\"EventPaymentRefundAccount\", fields: [refundAccountId], references: [id], onDelete: Restrict)\n  registration  EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)\n\n  @@index([registrationId])\n  @@index([refundStatus])\n  @@map(\"event_payments\")\n}\n\n// heardFrom / wouldRecommend: closed answers from src/lib/events/survey-questions.js\n// (plain strings, null on responses older than the questions).\nmodel EventSurveyResponse {\n  id              String   @id @default(uuid())\n  registrationId  String   @unique @map(\"registration_id\")\n  attended        Boolean\n  eventRating     Int?     @map(\"event_rating\")\n  heardFrom       String?  @map(\"heard_from\")\n  heardFromDetail String?  @map(\"heard_from_detail\")\n  wouldRecommend  String?  @map(\"would_recommend\")\n  submittedAt     DateTime @default(now()) @map(\"submitted_at\")\n\n  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)\n\n  @@map(\"event_survey_responses\")\n}\n\n// Material de estudio de un evento, en S3 privado bajo\n// event-materials/{curso}/{YYYY-MM-DD}_{slug}/. Solo lo descargan los\n// inscritos Confirmed que ya respondieron la encuesta (URL firmada).\nmodel EventMaterial {\n  id          String   @id @default(uuid())\n  eventId     String   @map(\"event_id\")\n  // Uploaded file: a key in AWS_S3_BUCKET, owned by this row. File of a post\n  // (postSlug set): a key in AWS_S3_POSTS_BUCKET, owned by the post. It is never\n  // copied, and removing the material leaves it in place. External link (url set,\n  // e.g. the recording): there is no file, so s3Key, mimeType and fileSize are\n  // null and fileName is the name the admin typed. A CHECK in the database\n  // requires exactly one of s3Key and url.\n  s3Key       String?  @map(\"s3_key\")\n  postSlug    String?  @map(\"post_slug\")\n  url         String?\n  fileName    String   @map(\"file_name\")\n  mimeType    String?  @map(\"mime_type\")\n  fileSize    Int?     @map(\"file_size\")\n  createdById String?  @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n\n  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)\n\n  @@unique([eventId, s3Key])\n  @@unique([eventId, url])\n  @@index([eventId, createdAt])\n  @@index([postSlug])\n  @@map(\"event_materials\")\n}\n\n// Pago al tutor hecho por fuera de la plataforma; solo trazabilidad.\nmodel EventTutorPayout {\n  id          String   @id @default(uuid())\n  eventId     String   @map(\"event_id\")\n  tutorId     String   @map(\"tutor_id\")\n  amount      Decimal  @db.Decimal(10, 2)\n  paidAt      DateTime @map(\"paid_at\")\n  note        String?\n  createdById String   @map(\"created_by_id\")\n  createdAt   DateTime @default(now()) @map(\"created_at\")\n  accountId   String?  @map(\"account_id\")\n  proofS3Key  String?  @map(\"proof_s3_key\")\n\n  account FinanceAccount? @relation(\"EventTutorPayoutAccount\", fields: [accountId], references: [id], onDelete: Restrict)\n  event   Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)\n  tutor   User            @relation(\"EventTutorPayouts\", fields: [tutorId], references: [id], onDelete: Restrict)\n\n  @@index([eventId])\n  @@map(\"event_tutor_payouts\")\n}\n\nmodel StudentReview {\n  id        String           @id @default(uuid())\n  sessionId String           @map(\"session_id\")\n  tutorId   String           @map(\"tutor_id\")\n  studentId String           @map(\"student_id\")\n  rating    Int?\n  status    ReviewStatusEnum @default(pending)\n  comment   String?\n  createdAt DateTime         @default(now()) @map(\"created_at\")\n  updatedAt DateTime         @updatedAt @map(\"updated_at\")\n  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student   User             @relation(\"StudentReviewsReceived\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor     User             @relation(\"StudentReviewsWritten\", fields: [tutorId], references: [id], onDelete: Cascade)\n\n  @@unique([sessionId, tutorId, studentId])\n  @@index([studentId, status])\n  @@map(\"student_reviews\")\n}\n\nmodel Payment {\n  createdAt             DateTime              @default(now()) @map(\"created_at\")\n  sessionId             String                @map(\"session_id\")\n  studentId             String                @map(\"student_id\")\n  tutorId               String                @map(\"tutor_id\")\n  // Desglose del cobro (single source of truth: src/lib/payments/fees.js):\n  //   originalAmount  = precio de lista (precio/hora × horas)\n  //   discountAmount  = descuento del cupón (0 sin cupón)\n  //   amount          = originalAmount − discountAmount → lo que Wompi cobró\n  //   tutorPayoutBase = base del 85 % del tutor: originalAmount cuando Calico\n  //                     asume el descuento, amount cuando es compartido\n  amount                Decimal               @db.Decimal(10, 2)\n  originalAmount        Decimal               @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount        Decimal               @default(0) @map(\"discount_amount\") @db.Decimal(10, 2)\n  tutorPayoutBase       Decimal               @map(\"tutor_payout_base\") @db.Decimal(10, 2)\n  couponId              String?               @map(\"coupon_id\")\n  // Único: un webhook y un confirm-payment concurrentes no pueden crear dos\n  // pagos para la misma transacción (NULL permitido para tutorías manuales).\n  wompiId               String?               @unique @map(\"wompi_id\")\n  id                    String                @id @default(uuid())\n  updatedAt             DateTime?             @updatedAt @map(\"updated_at\")\n  status                PaymentStatusEnum     @default(pending)\n  tutorPayoutStatus     TutorPayoutStatusEnum @default(pending) @map(\"tutor_payout_status\")\n  tutorPayoutAt         DateTime?             @map(\"tutor_payout_at\")\n  tutorPayoutNote       String?               @map(\"tutor_payout_note\")\n  tutorPayoutById       String?               @map(\"tutor_payout_by_id\")\n  // Comprobante de una tutoría manual: el estudiante paga por fuera al terminar\n  // y subir esta captura es lo que marca el pago como `paid`. Objeto privado en\n  // S3; solo admin lo ve, con una URL firmada de vida corta.\n  proofS3Key            String?               @map(\"proof_s3_key\")\n  proofUploadedAt       DateTime?             @map(\"proof_uploaded_at\")\n  // Transferencia al tutor (libro de movimientos): desde qué cuenta salió y su\n  // comprobante (finance-proofs/ en S3). Obligatorios desde el libro.\n  tutorPayoutAccountId  String?               @map(\"tutor_payout_account_id\")\n  tutorPayoutProofS3Key String?               @map(\"tutor_payout_proof_s3_key\")\n  // Devolución al estudiante (total o parcial).\n  refundStatus          EventRefundStatusEnum @default(None) @map(\"refund_status\")\n  refundAmount          Decimal?              @map(\"refund_amount\") @db.Decimal(10, 2)\n  refundReason          String?               @map(\"refund_reason\")\n  refundedAt            DateTime?             @map(\"refunded_at\")\n  refundedById          String?               @map(\"refunded_by_id\")\n  refundAccountId       String?               @map(\"refund_account_id\")\n  refundProofS3Key      String?               @map(\"refund_proof_s3_key\")\n  tutorPayoutAccount    FinanceAccount?       @relation(\"PaymentPayoutAccount\", fields: [tutorPayoutAccountId], references: [id], onDelete: Restrict)\n  refundAccount         FinanceAccount?       @relation(\"PaymentRefundAccount\", fields: [refundAccountId], references: [id], onDelete: Restrict)\n  session               Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  student               User                  @relation(\"PaymentsStudent\", fields: [studentId], references: [id], onDelete: Cascade)\n  tutor                 User                  @relation(\"PaymentsTutor\", fields: [tutorId], references: [id], onDelete: Cascade)\n  coupon                Coupon?               @relation(fields: [couponId], references: [id], onDelete: Restrict)\n  couponRedemption      CouponRedemption?\n\n  @@index([tutorPayoutStatus, status])\n  @@index([tutorId, tutorPayoutStatus])\n  @@index([couponId])\n  @@map(\"payments\")\n}\n\nmodel PaymentIntent {\n  id         String                @id @default(uuid())\n  reference  String                @unique\n  metadata   Json\n  consumedAt DateTime?             @map(\"consumed_at\")\n  kind       PaymentIntentKindEnum @default(session)\n  createdAt  DateTime              @default(now()) @map(\"created_at\")\n\n  @@map(\"payment_intents\")\n}\n\n// Cupón de descuento que el estudiante escribe antes de pagar. Reglas de\n// negocio en src/lib/services/coupon.service.js; matemática pura en\n// src/lib/payments/coupon-math.js. Borrado lógico (deletedAt) cuando ya tiene\n// redenciones, para no perder trazabilidad.\nmodel Coupon {\n  id               String                 @id @default(uuid())\n  code             String                 @unique // siempre en mayúsculas\n  description      String?\n  discountType     CouponDiscountTypeEnum @map(\"discount_type\")\n  discountValue    Decimal                @map(\"discount_value\") @db.Decimal(10, 2) // % (1-99) o COP\n  absorber         CouponAbsorberEnum     @default(CALICO)\n  maxRedemptions   Int?                   @map(\"max_redemptions\") // null = sin límite\n  perUserLimit     Int                    @default(1) @map(\"per_user_limit\")\n  firstSessionOnly Boolean                @default(false) @map(\"first_session_only\")\n  validFrom        DateTime?              @map(\"valid_from\")\n  validUntil       DateTime?              @map(\"valid_until\")\n  isActive         Boolean                @default(true) @map(\"is_active\")\n  createdById      String?                @map(\"created_by_id\")\n  createdAt        DateTime               @default(now()) @map(\"created_at\")\n  updatedAt        DateTime               @updatedAt @map(\"updated_at\")\n  deletedAt        DateTime?              @map(\"deleted_at\")\n\n  createdBy   User?              @relation(\"CouponCreator\", fields: [createdById], references: [id], onDelete: SetNull)\n  redemptions CouponRedemption[]\n  payments    Payment[]\n\n  @@index([isActive, deletedAt])\n  @@map(\"coupons\")\n}\n\n// Una fila por intento de pago que usó un cupón. Guarda el snapshot del\n// desglose para que editar el cupón después no reescriba la historia.\nmodel CouponRedemption {\n  id              String                     @id @default(uuid())\n  couponId        String                     @map(\"coupon_id\")\n  userId          String                     @map(\"user_id\")\n  intentReference String                     @unique @map(\"intent_reference\")\n  status          CouponRedemptionStatusEnum @default(RESERVED)\n  originalAmount  Decimal                    @map(\"original_amount\") @db.Decimal(10, 2)\n  discountAmount  Decimal                    @map(\"discount_amount\") @db.Decimal(10, 2)\n  finalAmount     Decimal                    @map(\"final_amount\") @db.Decimal(10, 2)\n  tutorPayoutBase Decimal                    @map(\"tutor_payout_base\") @db.Decimal(10, 2)\n  absorber        CouponAbsorberEnum\n  paymentId       String?                    @unique @map(\"payment_id\")\n  sessionId       String?                    @map(\"session_id\")\n  reservedAt      DateTime                   @default(now()) @map(\"reserved_at\")\n  approvedAt      DateTime?                  @map(\"approved_at\")\n  releasedAt      DateTime?                  @map(\"released_at\")\n\n  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)\n  user    User     @relation(\"CouponRedemptions\", fields: [userId], references: [id], onDelete: Cascade)\n  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)\n  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)\n\n  @@index([couponId, status, reservedAt])\n  @@index([userId, couponId, status])\n  @@map(\"coupon_redemptions\")\n}\n\nmodel TutorApplication {\n  id              String                     @id @default(uuid())\n  userId          String                     @map(\"user_id\")\n  reasonsToTeach  String                     @map(\"reasons_to_teach\")\n  subjects        String[]\n  contactInfo     Json                       @map(\"contact_info\")\n  status          TutorApplicationStatusEnum @default(Pending)\n  createdAt       DateTime                   @default(now()) @map(\"created_at\")\n  updatedAt       DateTime                   @updatedAt @map(\"updated_at\")\n  rejectionReason String?                    @map(\"rejection_reason\")\n  reviewedAt      DateTime?                  @map(\"reviewed_at\")\n  reviewedById    String?                    @map(\"reviewed_by_id\")\n  reviewedBy      User?                      @relation(\"ApplicationReviewedBy\", fields: [reviewedById], references: [id])\n  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"tutor_applications\")\n}\n\nmodel Notification {\n  id        String   @id @default(uuid())\n  userId    String   @map(\"user_id\")\n  type      String\n  message   String\n  isRead    Boolean  @default(false) @map(\"is_read\")\n  sessionId String?  @map(\"session_id\")\n  metadata  Json?\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n  session   Session? @relation(fields: [sessionId], references: [id])\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, isRead])\n  @@index([userId, createdAt(sort: Desc)])\n  @@map(\"notifications\")\n}\n\n// Noticias/anuncios publicados por admins y mostrados en la landing y en los\n// homes de estudiante y tutor. `content` es Markdown crudo (un solo idioma);\n// se renderiza en el cliente sin HTML embebido. `imageUrl` apunta a S3\n// (prefijo news-images/), URL pública persistida igual que profilePictureUrl.\nmodel NewsPost {\n  id          String    @id @default(uuid())\n  title       String\n  content     String\n  imageUrl    String?   @map(\"image_url\")\n  isPublished Boolean   @default(false) @map(\"is_published\")\n  isPinned    Boolean   @default(false) @map(\"is_pinned\")\n  publishedAt DateTime? @map(\"published_at\")\n  authorId    String    @map(\"author_id\")\n  createdAt   DateTime  @default(now()) @map(\"created_at\")\n  updatedAt   DateTime  @updatedAt @map(\"updated_at\")\n  author      User      @relation(\"NewsAuthor\", fields: [authorId], references: [id])\n\n  @@index([isPublished, isPinned, publishedAt(sort: Desc)])\n  @@map(\"news_posts\")\n}\n\nmodel AdminAuditLog {\n  id         String   @id @default(uuid())\n  adminId    String   @map(\"admin_id\")\n  action     String\n  targetType String?  @map(\"target_type\")\n  targetId   String?  @map(\"target_id\")\n  payload    Json?\n  ipAddress  String?  @map(\"ip_address\")\n  userAgent  String?  @map(\"user_agent\")\n  createdAt  DateTime @default(now()) @map(\"created_at\")\n  admin      User     @relation(\"AdminActor\", fields: [adminId], references: [id])\n\n  @@index([adminId, createdAt(sort: Desc)])\n  @@index([action, createdAt(sort: Desc)])\n  @@index([targetType, targetId])\n  @@map(\"admin_audit_log\")\n}\n\n// Piezas de marketing (posts de Instagram y presentaciones) que se crean con la\n// herramienta local content-creator. Aquí vive la fuente compartida de cada\n// pieza: brief e historial (`meta`), caption y la lista de archivos fuente\n// (`files`: index.html, img/*), que están en S3 bajo marketing-pieces/{slug}/src/.\n// Lo publicado (PNG/PDF + manifest.json) sigue en marketing-posts/{slug}/.\n// `version` sube en cada guardado: el cliente manda la versión que leyó y si no\n// coincide recibe 409 (otra persona guardó antes).\nmodel MarketingPiece {\n  id                     String    @id @default(uuid())\n  slug                   String    @unique\n  title                  String\n  type                   String\n  style                  String?\n  caption                String    @default(\"\")\n  meta                   Json      @default(\"{}\")\n  files                  Json      @default(\"[]\")\n  version                Int       @default(1)\n  createdById            String    @map(\"created_by_id\")\n  updatedById            String    @map(\"updated_by_id\")\n  publishedById          String?   @map(\"published_by_id\")\n  publishedAt            DateTime? @map(\"published_at\")\n  // Agenda (la pone una persona; subir a Instagram es a mano). Se deriva del\n  // `meta` que manda content-creator (planId, fechaPublicacion, publicadaInstagramEn)\n  // y Admin → Posts la puede cambiar. `planEntryKey` es el `key` de la entrada del\n  // plan de la que salió la pieza (enlace suave: borrar la entrada no borra la pieza).\n  planEntryKey           String?   @map(\"plan_entry_key\")\n  plannedFor             DateTime? @map(\"planned_for\") @db.Date\n  instagramPublishedAt   DateTime? @map(\"instagram_published_at\") @db.Date\n  instagramPublishedById String?   @map(\"instagram_published_by_id\")\n  createdAt              DateTime  @default(now()) @map(\"created_at\")\n  updatedAt              DateTime  @updatedAt @map(\"updated_at\")\n  createdBy              User      @relation(\"MarketingPieceCreator\", fields: [createdById], references: [id])\n  updatedBy              User      @relation(\"MarketingPieceUpdater\", fields: [updatedById], references: [id])\n  publishedBy            User?     @relation(\"MarketingPiecePublisher\", fields: [publishedById], references: [id])\n  instagramPublishedBy   User?     @relation(\"MarketingPieceInstagramPublisher\", fields: [instagramPublishedById], references: [id])\n\n  @@index([updatedAt(sort: Desc)])\n  @@index([planEntryKey])\n  @@index([plannedFor])\n  @@map(\"marketing_pieces\")\n}\n\n// Plan de contenido de Instagram (content-creator): una guía de qué publicar\n// cada día de una temporada. `settings` guarda lo que el estudio necesita para\n// dibujarlo (semanas del semestre, fases, festivos, nota). `version` funciona\n// igual que en las piezas: 409 si otra persona guardó antes.\nmodel MarketingPlan {\n  id          String               @id @default(uuid())\n  key         String               @unique // p. ej. \"2026-2\"\n  title       String\n  startsOn    DateTime             @map(\"starts_on\") @db.Date\n  endsOn      DateTime             @map(\"ends_on\") @db.Date\n  settings    Json                 @default(\"{}\")\n  version     Int                  @default(1)\n  createdById String               @map(\"created_by_id\")\n  updatedById String               @map(\"updated_by_id\")\n  createdAt   DateTime             @default(now()) @map(\"created_at\")\n  updatedAt   DateTime             @updatedAt @map(\"updated_at\")\n  createdBy   User                 @relation(\"MarketingPlanCreator\", fields: [createdById], references: [id])\n  updatedBy   User                 @relation(\"MarketingPlanUpdater\", fields: [updatedById], references: [id])\n  entries     MarketingPlanEntry[]\n\n  @@index([endsOn])\n  @@map(\"marketing_plans\")\n}\n\n// Una fila por entrada del plan, para moverla, editarla o saltarla sin tocar\n// las demás. `key` es el slug que tendrá la pieza que nazca de ella (por eso es\n// único en toda la tabla). `brief` es lo que llega al formulario del estudio;\n// `details` el resto (idea, gancho, estilo, material que necesita, preguntas de\n// una grabación…). `skipped` = el equipo decidió no hacerla.\nmodel MarketingPlanEntry {\n  id          String        @id @default(uuid())\n  planId      String        @map(\"plan_id\")\n  key         String        @unique\n  date        DateTime      @db.Date\n  format      String\n  title       String\n  brief       Json?\n  details     Json          @default(\"{}\")\n  skipped     Boolean       @default(false)\n  version     Int           @default(1)\n  createdById String        @map(\"created_by_id\")\n  updatedById String        @map(\"updated_by_id\")\n  createdAt   DateTime      @default(now()) @map(\"created_at\")\n  updatedAt   DateTime      @updatedAt @map(\"updated_at\")\n  plan        MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\n  createdBy   User          @relation(\"MarketingPlanEntryCreator\", fields: [createdById], references: [id])\n  updatedBy   User          @relation(\"MarketingPlanEntryUpdater\", fields: [updatedById], references: [id])\n\n  @@index([planId, date])\n  @@map(\"marketing_plan_entries\")\n}\n\n// Tokens personales para que content-creator use /api/content-creator/*.\n// Solo se guarda el SHA-256 del token; el token en claro se muestra una vez al\n// crearlo (prisma/create-content-token.mjs). Cada token pertenece a un admin:\n// si el usuario deja de ser ADMIN o se desactiva, el token deja de servir.\nmodel ContentCreatorToken {\n  id         String    @id @default(uuid())\n  userId     String    @map(\"user_id\")\n  label      String\n  tokenHash  String    @unique @map(\"token_hash\")\n  lastUsedAt DateTime? @map(\"last_used_at\")\n  revokedAt  DateTime? @map(\"revoked_at\")\n  createdAt  DateTime  @default(now()) @map(\"created_at\")\n  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@map(\"content_creator_tokens\")\n}\n\n// ─── FINANZAS: LIBRO DE MOVIMIENTOS ──────────────────────────────────────\n// Dinero real que entra y sale de las cuentas de Calico desde una fecha de\n// corte. Solo se agrega: lo registrado se corrige con un REVERSAL, nunca se\n// edita ni se borra. Los movimientos automáticos se proyectan desde pagos,\n// pagos a tutores y devoluciones (src/lib/services/finance-ledger.service.js),\n// con `source_key` única para que reproyectar nunca duplique.\n\nenum FinanceAccountTypeEnum {\n  WOMPI\n  BANK\n  CASH\n}\n\nenum LedgerDirectionEnum {\n  IN\n  OUT\n}\n\nenum LedgerEntryTypeEnum {\n  OPENING_BALANCE\n  SESSION_CHARGE\n  EVENT_CHARGE\n  WOMPI_FEE\n  TUTOR_PAYOUT\n  EVENT_TUTOR_PAYOUT\n  GMF\n  REFUND\n  TRANSFER\n  EXPENSE\n  OTHER_INCOME\n  ADJUSTMENT\n  REVERSAL\n}\n\nmodel FinanceAccount {\n  id         String                 @id @default(uuid())\n  name       String                 @unique\n  type       FinanceAccountTypeEnum\n  // Las salidas de esta cuenta causan 4x1000 (cuentas bancarias no exentas).\n  gmfApplies Boolean                @default(false) @map(\"gmf_applies\")\n  isActive   Boolean                @default(true) @map(\"is_active\")\n  createdAt  DateTime               @default(now()) @map(\"created_at\")\n\n  entries             LedgerEntry[]\n  paymentPayouts      Payment[]          @relation(\"PaymentPayoutAccount\")\n  paymentRefunds      Payment[]          @relation(\"PaymentRefundAccount\")\n  eventTutorPayouts   EventTutorPayout[] @relation(\"EventTutorPayoutAccount\")\n  eventPaymentRefunds EventPayment[]     @relation(\"EventPaymentRefundAccount\")\n\n  @@map(\"finance_accounts\")\n}\n\n/// Configuración única (id = 1) del libro.\nmodel FinanceSettings {\n  id                     Int       @id @default(1)\n  // Desde esta fecha todo movimiento entra al libro; antes, solo el saldo inicial.\n  cutoffDate             DateTime? @map(\"cutoff_date\")\n  gmfRate                Decimal   @default(0.004) @map(\"gmf_rate\") @db.Decimal(6, 5)\n  wompiAccountId         String?   @map(\"wompi_account_id\")\n  defaultBankAccountId   String?   @map(\"default_bank_account_id\")\n  defaultManualAccountId String?   @map(\"default_manual_account_id\")\n  updatedAt              DateTime  @updatedAt @map(\"updated_at\")\n  updatedById            String?   @map(\"updated_by_id\")\n\n  @@map(\"finance_settings\")\n}\n\nmodel ExpenseCategory {\n  id        String   @id @default(uuid())\n  name      String   @unique\n  isActive  Boolean  @default(true) @map(\"is_active\")\n  createdAt DateTime @default(now()) @map(\"created_at\")\n\n  entries LedgerEntry[]\n\n  @@map(\"expense_categories\")\n}\n\nmodel LedgerEntry {\n  id                String              @id @default(uuid())\n  type              LedgerEntryTypeEnum\n  direction         LedgerDirectionEnum\n  // Siempre positivo; `direction` dice si entra o sale de la cuenta.\n  amount            Decimal             @db.Decimal(12, 2)\n  accountId         String              @map(\"account_id\")\n  // Cuándo pasó la plata (no cuándo se registró).\n  effectiveAt       DateTime            @map(\"effective_at\")\n  createdAt         DateTime            @default(now()) @map(\"created_at\")\n  // Origen de un movimiento automático: \"<TYPE>:<id>\" (único → idempotente).\n  sourceKey         String?             @unique @map(\"source_key\")\n  sourceType        String?             @map(\"source_type\")\n  sourceId          String?             @map(\"source_id\")\n  // Valor estimado (comisión Wompi, 4x1000): la conciliación lo ajusta.\n  isEstimate        Boolean             @default(false) @map(\"is_estimate\")\n  // Movimientos de cursos de prueba: entran a caja, no a la ganancia.\n  excludeFromProfit Boolean             @default(false) @map(\"exclude_from_profit\")\n  categoryId        String?             @map(\"category_id\")\n  description       String?\n  proofS3Key        String?             @map(\"proof_s3_key\")\n  // Un TRANSFER son dos filas (OUT + IN) con el mismo grupo.\n  transferGroupId   String?             @map(\"transfer_group_id\")\n  reversesId        String?             @unique @map(\"reverses_id\")\n  tutorId           String?             @map(\"tutor_id\")\n  createdById       String?             @map(\"created_by_id\")\n\n  account    FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)\n  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)\n  reverses   LedgerEntry?     @relation(\"LedgerReversal\", fields: [reversesId], references: [id], onDelete: Restrict)\n  reversedBy LedgerEntry?     @relation(\"LedgerReversal\")\n\n  @@index([accountId, effectiveAt])\n  @@index([effectiveAt])\n  @@index([type, effectiveAt])\n  @@map(\"ledger_entries\")\n}\n"
